---
// ArticleCard.astro — blog grid card (2col/3col layout)
interface Props {
  title: string;
  slug: string;
  excerpt?: string;
  featuredImage?: string;
  author?: string;
  date?: string;
  categories?: string[];
  overlay?: boolean;
}

const { title, slug, excerpt, featuredImage, author, date, categories = [], overlay = false } = Astro.props;
const formattedDate = date ? new Date(date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
---

<article class={`entry-item${overlay ? ' overlay-card' : ''}`}>
  {featuredImage && (
    <div class="entry-item-thumb">
      <a href={`/blog/${slug}`} tabindex="-1" aria-hidden="true">
        <img src={featuredImage} alt={title} width="615" height="410" loading="lazy" />
      </a>
    </div>
  )}
  <div class="entry-item-content">
    <header class="entry-header">
      <h2 class="entry-item-title">
        <a href={`/blog/${slug}`}>{title}</a>
      </h2>
    </header>
    {(date || author || categories.length > 0) && (
      <div class="entry-meta">
        {date && <time datetime={date}>{formattedDate}</time>}
        {author && <span>by {author}</span>}
        {categories.length > 0 && (
          <span>{categories.map((c, i) => (
            <>{i > 0 && ', '}<a href={`/blog/category/${c.toLowerCase().replace(/\s+/g,'-')}`}>{c}</a></>
          ))}</span>
        )}
      </div>
    )}
    {excerpt && <p class="entry-item-excerpt">{excerpt}</p>}
    {!overlay && (
      <a href={`/blog/${slug}`} class="btn btn-outline" style="margin-top:auto;align-self:flex-start;">
        Read More
      </a>
    )}
  </div>
</article>
