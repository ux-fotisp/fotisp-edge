---
// EventCard.astro — Rich event archive card (Eventbrite/Meetup grade)
interface Props {
  title: string;
  slug: string;
  tagline?: string;
  excerpt?: string;
  eventDate: string;
  timeSlot: string;
  status: 'UPCOMING' | 'LIVE' | 'COMPLETED' | 'RECURRING';
  eventType: 'VIRTUAL' | 'HYBRID' | 'IN_PERSON';
  location: { name: string; address?: string; virtualLink?: string };
  capacity?: { totalSeats?: number; registeredCount?: number };
  speakers?: { name: string; role: string; company: string; avatar?: string }[];
}

const { title, slug, tagline, excerpt, eventDate, timeSlot, status, eventType, location, capacity, speakers } = Astro.props;

const d = new Date(eventDate);
const dayStr  = d.getDate().toString().padStart(2, '0');
const monthStr = d.toLocaleString('en-GB', { month: 'short' }).toUpperCase();
const yearStr  = d.getFullYear();

const statusConfig: Record<string, { label: string; color: string; bg: string }> = {
  UPCOMING:  { label: 'UPCOMING',  color: '#22C55E', bg: 'rgba(34,197,94,0.12)' },
  LIVE:      { label: '● LIVE',    color: '#EF4444', bg: 'rgba(239,68,68,0.15)' },
  COMPLETED: { label: 'COMPLETED', color: '#9CA3AF', bg: 'rgba(156,163,175,0.12)' },
  RECURRING: { label: 'RECURRING', color: '#A78BFA', bg: 'rgba(167,139,250,0.12)' },
};
const typeConfig: Record<string, { label: string; icon: string }> = {
  VIRTUAL:   { label: 'Virtual',   icon: '🌐' },
  HYBRID:    { label: 'Hybrid',    icon: '🔀' },
  IN_PERSON: { label: 'In Person', icon: '📍' },
};

const sc = statusConfig[status] ?? statusConfig.UPCOMING;
const tc = typeConfig[eventType] ?? typeConfig.IN_PERSON;

const fillPct = capacity?.totalSeats && capacity?.registeredCount
  ? Math.min(100, Math.round((capacity.registeredCount / capacity.totalSeats) * 100))
  : null;

const spotsLeft = capacity?.totalSeats && capacity?.registeredCount
  ? capacity.totalSeats - capacity.registeredCount
  : null;
---

<article class="event-card" style="position:relative;background:var(--color-surface);border:1px solid var(--color-border-deep);border-radius:var(--radius-md);overflow:hidden;transition:border-color 0.3s ease,box-shadow 0.3s ease;display:flex;gap:0;">

  {/* Date Badge Column */}
  <div style="min-width:72px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px 12px;background:rgba(220,38,38,0.08);border-right:1px solid var(--color-border-deep);">
    <span style="font-size:28px;font-weight:900;line-height:1;color:#FFFFFF;font-family:var(--font-sans);">{dayStr}</span>
    <span style="font-size:11px;font-weight:700;letter-spacing:0.12em;color:var(--color-primary);margin-top:2px;">{monthStr}</span>
    <span style="font-size:11px;color:var(--color-muted);margin-top:2px;">{yearStr}</span>
  </div>

  {/* Main Content */}
  <div style="flex:1;padding:20px 24px;display:flex;flex-direction:column;gap:10px;">

    {/* Top row: Status + Type chips */}
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
      <span style={`font-size:10px;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;padding:3px 10px;border-radius:9999px;color:${sc.color};background:${sc.bg};border:1px solid ${sc.color}40;`}>
        {sc.label}
      </span>
      <span style="font-size:10px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;padding:3px 10px;border-radius:9999px;color:var(--color-silver);background:rgba(209,213,219,0.08);border:1px solid rgba(209,213,219,0.15);">
        {tc.icon} {tc.label}
      </span>
    </div>

    {/* Title */}
    <h3 style="font-size:1.05rem;font-weight:800;line-height:1.3;letter-spacing:var(--tracking-tight);margin:0;">
      <a href={`/events/${slug}`} style="color:#FFFFFF;text-decoration:none;transition:color 0.2s ease;" onmouseover="this.style.color='#DC2626'" onmouseout="this.style.color='#FFFFFF'">
        {title}
      </a>
    </h3>

    {tagline && (
      <p style="font-size:13px;color:var(--color-muted);margin:0;font-style:italic;">{tagline}</p>
    )}

    {/* Meta row */}
    <div style="display:flex;flex-wrap:wrap;gap:14px;font-size:12px;color:var(--color-silver);">
      <span>🕐 {timeSlot}</span>
      <span>{tc.icon} {location.name}{location.address ? `, ${location.address.split(',')[0]}` : ''}</span>
    </div>

    {excerpt && (
      <p style="font-size:13px;color:var(--color-muted);line-height:1.6;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
        {excerpt}
      </p>
    )}

    {/* Capacity Bar */}
    {fillPct !== null && (
      <div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:5px;">
          <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--color-muted);">Capacity</span>
          <span style={`font-size:11px;font-weight:700;color:${fillPct >= 90 ? '#EF4444' : fillPct >= 70 ? '#F59E0B' : '#22C55E'};`}>
            {spotsLeft} spots left
          </span>
        </div>
        <div style="height:4px;background:rgba(255,255,255,0.08);border-radius:9999px;overflow:hidden;">
          <div style={`height:100%;width:${fillPct}%;background:${fillPct >= 90 ? '#EF4444' : fillPct >= 70 ? '#F59E0B' : '#22C55E'};border-radius:9999px;transition:width 0.6s ease;`}></div>
        </div>
      </div>
    )}

    {/* Speakers Avatar Stack + CTA */}
    <div style="display:flex;align-items:center;justify-content:space-between;margin-top:4px;flex-wrap:wrap;gap:10px;">
      {speakers && speakers.length > 0 && (
        <div style="display:flex;align-items:center;gap:6px;">
          <div style="display:flex;">
            {speakers.slice(0, 4).map((sp, i) => (
              <div
                title={`${sp.name} — ${sp.role}, ${sp.company}`}
                style={`width:28px;height:28px;border-radius:50%;border:2px solid var(--color-surface);background:linear-gradient(135deg,#380F15,#701A1A);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#FFFFFF;margin-left:${i > 0 ? '-8px' : '0'};position:relative;z-index:${4-i};`}
                aria-label={sp.name}
              >
                {sp.name.charAt(0)}
              </div>
            ))}
            {speakers.length > 4 && (
              <div style="width:28px;height:28px;border-radius:50%;border:2px solid var(--color-surface);background:rgba(220,38,38,0.2);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:var(--color-primary);margin-left:-8px;position:relative;z-index:0;">
                +{speakers.length - 4}
              </div>
            )}
          </div>
          <span style="font-size:11px;color:var(--color-muted);">{speakers.length} speaker{speakers.length > 1 ? 's' : ''}</span>
        </div>
      )}
      <a
        href={`/events/${slug}`}
        style="font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-primary);text-decoration:none;display:flex;align-items:center;gap:5px;transition:gap 0.2s ease;"
        onmouseover="this.style.gap='9px'"
        onmouseout="this.style.gap='5px'"
      >
        View Details <span aria-hidden="true">→</span>
      </a>
    </div>

  </div>
</article>

<style>
  .event-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 0 24px rgba(220, 38, 38, 0.2);
    transform: translateY(-2px);
  }
</style>
