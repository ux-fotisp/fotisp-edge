---
// TeamCard.astro — Rich Team Member Card (matching EventCard & ServiceCard dark aesthetics)
interface Props {
  name: string;
  slug: string;
  role?: string;
  photo?: string;
  bio?: string;
  social?: { linkedin?: string; twitter?: string; facebook?: string };
}

const { name, slug, role, photo, bio, social } = Astro.props;
const fallbackSlug = name ? name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') : 'member';
const rawSlug = slug || fallbackSlug;
const cleanSlug = rawSlug.replace(/\.mdx?$/, '');
const initials = name ? name.split(' ').map(n => n[0]).join('') : 'TM';
---

<article class="team-card">
  <div class="team-card-image-wrap">
    {photo ? (
      <img src={photo} alt={name} class="team-member-photo" width="400" height="400" loading="lazy" />
    ) : (
      <div class="team-member-avatar" aria-hidden="true">
        {initials}
      </div>
    )}
    {role && <span class="team-card-badge">{role}</span>}
  </div>

  <div class="team-card-body">
    <h3 class="team-card-name">
      <a href={`/team/${cleanSlug}`}>{name}</a>
    </h3>

    {bio && (
      <p class="team-card-bio">{bio}</p>
    )}

    <div class="team-card-footer">
      {social && (
        <div class="team-card-social">
          {social.linkedin && <a href={social.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${name} LinkedIn`}>LinkedIn</a>}
          {social.twitter && <a href={social.twitter} target="_blank" rel="noopener noreferrer" aria-label={`${name} Twitter`}>Twitter</a>}
        </div>
      )}
      <a href={`/team/${cleanSlug}`} class="team-card-link">
        View Profile <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>

<style>
  .team-card {
    position: relative;
    background: var(--color-surface, #0F0909);
    border: 1px solid var(--color-border-deep, #380F15);
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.3s ease,
                box-shadow 0.3s ease;
  }

  .team-card:hover {
    transform: translateY(-4px);
    border-color: rgba(220, 38, 38, 0.55) !important;
    box-shadow: 0 0 24px rgba(220, 38, 38, 0.18), 0 12px 30px rgba(0, 0, 0, 0.4) !important;
  }

  .team-card-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: linear-gradient(135deg, #1A080B, #080303);
    border-bottom: 1px solid var(--color-border-deep, #380F15);
  }

  .team-card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transition: transform 0.5s ease;
  }

  .team-card:hover .team-card-image-wrap img {
    transform: scale(1.05);
  }

  .team-member-avatar {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-primary, #DC2626);
    background: linear-gradient(135deg, rgba(220, 38, 38, 0.15), rgba(112, 26, 26, 0.3));
    font-family: var(--font-sans, sans-serif);
  }

  .team-card-badge {
    position: absolute;
    bottom: 12px;
    left: 12px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary, #DC2626);
    background: rgba(8, 3, 3, 0.85);
    border: 1px solid rgba(220, 38, 38, 0.35);
    padding: 4px 10px;
    border-radius: 9999px;
    backdrop-filter: blur(8px);
  }

  .team-card-body {
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 10px;
  }

  .team-card-name {
    font-size: 1.1rem;
    font-weight: 800;
    line-height: 1.3;
    margin: 0;
  }

  .team-card-name a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .team-card-name a:hover {
    color: var(--color-primary, #DC2626);
  }

  .team-card-bio {
    font-size: 13px;
    color: var(--color-text-light, #9CA3AF);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .team-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    gap: 10px;
    flex-wrap: wrap;
  }

  .team-card-social {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .team-card-social a {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #9CA3AF;
    text-decoration: none;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .team-card-social a:hover {
    color: #ffffff;
    background: rgba(220, 38, 38, 0.2);
    border-color: rgba(220, 38, 38, 0.4);
  }

  .team-card-link {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary, #DC2626);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: gap 0.2s ease;
    margin-left: auto;
  }

  .team-card-link:hover {
    gap: 9px;
  }
</style>

