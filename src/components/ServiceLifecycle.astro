---
// ServiceLifecycle.astro — 4-Step Interactive Methodology Pipeline
const steps = [
  {
    num: '01',
    title: 'ARCHITECTURAL AUDIT',
    description: 'Kernel-level telemetry and bottleneck analysis across infrastructure topology.'
  },
  {
    num: '02',
    title: 'EDGE DEPLOYMENT',
    description: 'Zero-downtime deployment of WebAssembly micro-runtimes across 450+ global POPs.'
  },
  {
    num: '03',
    title: 'AUTOMATED MONITORING',
    description: 'Real-time telemetry ingestion with sub-millisecond anomaly detection algorithms.'
  },
  {
    num: '04',
    title: 'CONTINUOUS OPTIMIZATION',
    description: 'Algorithmic performance tuning and automated zero-trust security attestation.'
  }
];
---

<section class="service-lifecycle-section" aria-label="Our 4-step methodology pipeline">
  <div class="lifecycle-header">
    <span class="lifecycle-tag">METHODOLOGY</span>
    <h2 class="lifecycle-title">THE EDGE LIFECYCLE PIPELINE</h2>
  </div>

  <div class="lifecycle-pipeline">
    <div class="laser-track-bg"></div>

    <div class="steps-grid">
      {steps.map((step) => (
        <div class="lifecycle-step-card" tabindex="0">
          <div class="step-laser-indicator"></div>
          
          <div class="step-num">
            <span class="num-text">{step.num}</span>
            <span class="num-divider">//</span>
          </div>

          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .service-lifecycle-section {
    width: 100%;
    margin: 64px 0;
  }

  .lifecycle-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .lifecycle-tag {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: var(--color-scarlet-red, #ee2626);
    background: rgba(238, 38, 38, 0.1);
    border: 1px solid rgba(238, 38, 38, 0.3);
    padding: 4px 14px;
    border-radius: 9999px;
    display: inline-block;
    margin-bottom: 12px;
  }

  .lifecycle-title {
    font-size: 1.8rem;
    font-weight: 900;
    color: #FFFFFF;
    letter-spacing: var(--tracking-tight, -0.02em);
    margin: 0;
  }

  .lifecycle-pipeline {
    position: relative;
    background: var(--color-surface, #0F0909);
    border: 1px solid var(--color-border-deep, #380F15);
    border-radius: var(--radius-md, 8px);
    padding: 40px 32px;
    overflow: hidden;
  }

  /* Underlying laser track background line */
  .laser-track-bg {
    position: absolute;
    top: 50%;
    left: 40px;
    right: 40px;
    height: 2px;
    background: var(--color-border-deep, #380F15);
    z-index: 1;
    transform: translateY(-50%);
  }

  .steps-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media (max-width: 992px) {
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .laser-track-bg {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .steps-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Step Card */
  .lifecycle-step-card {
    position: relative;
    background: var(--color-burgundy, #1A080B);
    border: 1px solid var(--color-border-deep, #380F15);
    border-radius: var(--radius-md, 8px);
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    outline: none;
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.3s ease,
                box-shadow 0.3s ease;
  }

  /* Illuminated Crimson Laser Line per card */
  .step-laser-indicator {
    position: absolute;
    bottom: 0;
    left: 12px;
    right: 12px;
    height: 3px;
    background: transparent;
    border-radius: 9999px;
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .lifecycle-step-card:hover,
  .lifecycle-step-card:focus {
    transform: translateY(-4px);
    border-color: rgba(238, 38, 38, 0.6);
    box-shadow: 0 0 20px rgba(238, 38, 38, 0.25);
  }

  .lifecycle-step-card:hover .step-laser-indicator,
  .lifecycle-step-card:focus .step-laser-indicator {
    background: var(--color-scarlet-red, #ee2626);
    box-shadow: 0 0 12px var(--color-scarlet-red, #ee2626);
  }

  /* Step Number */
  .step-num {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: monospace;
    font-size: 1.1rem;
    font-weight: 900;
  }

  .num-text {
    color: var(--color-text-light, #9CA3AF);
    transition: color 0.3s ease, text-shadow 0.3s ease;
  }

  .num-divider {
    color: var(--color-border-deep, #380F15);
    font-size: 0.9rem;
  }

  .lifecycle-step-card:hover .num-text,
  .lifecycle-step-card:focus .num-text {
    color: var(--color-scarlet-red, #ee2626);
    text-shadow: 0 0 10px rgba(238, 38, 38, 0.6);
  }

  /* Step Title & Desc */
  .step-title {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #FFFFFF;
    margin: 0;
    line-height: 1.3;
  }

  .step-desc {
    font-size: 12px;
    color: #D1D5DB;
    line-height: 1.5;
    margin: 0;
  }
</style>
