---
// src/components/SEO.astro
export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'profile';
  publishedDate?: Date | string;
  updatedDate?: Date | string;
  author?: string;
}

const SITE_NAME = "EDGE | Fotis Pastrakis";
const DEFAULT_TITLE = "EDGE — Evidence-Based UX Strategy & High-Density Web Systems";
const DEFAULT_DESCRIPTION = "Digital laboratory and UX consultancy led by Fotis Pastrakis. 10+ years shaping evidence-based UX strategy, OOUX architectures, and edge performance.";
const DEFAULT_OG_IMAGE = "/images/og-default.jpg";

const {
  title,
  description = DEFAULT_DESCRIPTION,
  ogImage = DEFAULT_OG_IMAGE,
  canonicalUrl = Astro.url.href,
  noindex = false,
  type = 'website',
  publishedDate,
  updatedDate,
  author = "Fotis Pastrakis"
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_NAME}` : DEFAULT_TITLE;
const siteOrigin = Astro.site ? Astro.site.origin : Astro.url.origin;
const formattedOgImage = ogImage.startsWith('http://') || ogImage.startsWith('https://')
  ? ogImage
  : new URL(ogImage, siteOrigin).href;

const pubDateObj = publishedDate ? (publishedDate instanceof Date ? publishedDate : new Date(publishedDate)) : undefined;
const upDateObj = updatedDate ? (updatedDate instanceof Date ? updatedDate : new Date(updatedDate)) : undefined;
---

<!-- Basic Meta -->
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph / Facebook -->
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={formattedOgImage} />

{pubDateObj && !isNaN(pubDateObj.getTime()) && <meta property="article:published_time" content={pubDateObj.toISOString()} />}
{upDateObj && !isNaN(upDateObj.getTime()) && <meta property="article:modified_time" content={upDateObj.toISOString()} />}
{author && <meta property="article:author" content={author} />}

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={formattedOgImage} />
<meta name="twitter:creator" content="@ux_fotisp" />
