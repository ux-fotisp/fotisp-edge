---
// src/components/BackToTop.astro — Dynamic Granular Page-Progress Ring
---

<button
  id="segmented-back-to-top"
  class="back-to-top-btn"
  aria-label="Back to top & page scroll progress"
>
  <!-- Dynamic Segmented SVG Ring -->
  <svg class="progress-ring-svg" viewBox="0 0 100 100" aria-hidden="true">
    <g id="svg-segments-group">
      <!-- Injected dynamically via client-side script -->
    </g>
  </svg>

  <!-- Center Arrow Icon -->
  <svg
    class="center-arrow"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 19V5M5 12l7-7 7 7"></path>
  </svg>
</button>

<style>
  .back-to-top-btn {
    position: fixed;
    bottom: 28px;
    right: 28px;
    width: 58px;
    height: 58px;
    background: rgba(8, 3, 3, 0.94);
    border: 1px solid #380F15;
    border-radius: 50%;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transform: scale(0.8) translateY(16px);
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.3s ease,
                border-color 0.3s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6), 0 0 15px rgba(238, 38, 38, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 0;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .back-to-top-btn.visible {
    opacity: 1;
    visibility: visible;
    transform: scale(1) translateY(0);
  }

  .back-to-top-btn:hover {
    border-color: #ee2626;
    box-shadow: 0 6px 28px rgba(238, 38, 38, 0.45), 0 0 22px rgba(238, 38, 38, 0.35);
    transform: scale(1.08) translateY(-2px);
  }

  .back-to-top-btn:active {
    transform: scale(0.95) translateY(0);
  }

  .progress-ring-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    padding: 3px;
    pointer-events: none;
  }

  #svg-segments-group {
    pointer-events: auto;
  }

  .center-arrow {
    position: relative;
    z-index: 10;
    width: 20px;
    height: 20px;
    color: #ffffff;
    transition: color 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }

  .back-to-top-btn:hover .center-arrow {
    color: #ee2626;
    transform: translateY(-3px);
  }

  .segment-arc {
    transition: stroke 0.3s ease, filter 0.3s ease, stroke-width 0.25s ease, opacity 0.3s ease;
  }

  .segment-arc:hover {
    stroke: #ee2626 !important;
    filter: drop-shadow(0 0 10px rgba(238, 38, 38, 1)) !important;
    stroke-width: 5.5 !important;
  }
</style>

<script>
  function initGranularProgressRing() {
    const btn = document.getElementById('segmented-back-to-top');
    const segmentsGroup = document.getElementById('svg-segments-group');
    if (!btn || !segmentsGroup) return;

    // Check document scrollability
    function getScrollableMetrics() {
      const scrollHeight = document.documentElement.scrollHeight || document.body.scrollHeight;
      const clientHeight = window.innerHeight;
      const maxScroll = Math.max(0, scrollHeight - clientHeight);
      return { scrollHeight, clientHeight, maxScroll };
    }

    let { maxScroll, clientHeight, scrollHeight } = getScrollableMetrics();

    // Collect named section elements if available on page
    let sections = Array.from(document.querySelectorAll('main section[id], section[id]')) as HTMLElement[];

    // Calculate granular page segment count (smooth, gradual segmentation across scrollable depth)
    let numSegments = 8; // Default granular baseline

    if (sections.length >= 4) {
      numSegments = Math.min(14, Math.max(sections.length, 8));
    } else {
      // Calculate based on viewport page depth
      const viewportPages = Math.ceil(scrollHeight / Math.max(1, clientHeight));
      numSegments = Math.max(6, Math.min(12, viewportPages * 2));
    }

    const radius = 42;
    const circumference = 2 * Math.PI * radius; // ~263.89
    const gapDegrees = Math.max(3, 360 / (numSegments * 6)); // Gap scales with segment count
    const totalGapLength = (gapDegrees / 360) * circumference * numSegments;
    const segmentLength = (circumference - totalGapLength) / numSegments;
    const gapLength = (gapDegrees / 360) * circumference;

    segmentsGroup.innerHTML = '';

    // Build SVG Arc Segments
    for (let i = 0; i < numSegments; i++) {
      const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      const offset = -(i * (segmentLength + gapLength));

      circle.setAttribute('cx', '50');
      circle.setAttribute('cy', '50');
      circle.setAttribute('r', radius.toString());
      circle.setAttribute('fill', 'none');
      circle.setAttribute('stroke', '#380F15'); // Default inactive Dark Crimson
      circle.setAttribute('stroke-width', '4');
      circle.setAttribute('stroke-dasharray', `${segmentLength} ${circumference - segmentLength}`);
      circle.setAttribute('stroke-dashoffset', offset.toString());
      circle.setAttribute('stroke-linecap', 'round');
      circle.classList.add('segment-arc');
      circle.style.cursor = 'pointer';
      circle.dataset.index = i.toString();

      // Determine click-to-scroll target position
      let targetY = 0;
      if (sections.length >= numSegments && sections[i]) {
        targetY = sections[i].getBoundingClientRect().top + window.scrollY - 80;
      } else {
        targetY = (i / numSegments) * maxScroll;
      }
      circle.dataset.targetY = Math.round(targetY).toString();

      // Click segment to scroll directly to corresponding page position
      circle.addEventListener('click', (e) => {
        e.stopPropagation();
        const destY = parseFloat(circle.dataset.targetY || '0');
        window.scrollTo({ top: destY, behavior: 'smooth' });
      });

      segmentsGroup.appendChild(circle);
    }

    const segmentElements = Array.from(segmentsGroup.querySelectorAll('.segment-arc')) as SVGElement[];

    function updateScrollState() {
      const currentScrollY = window.scrollY;
      const { maxScroll: currentMaxScroll } = getScrollableMetrics();

      // 1. Visibility toggle: Show button after scrolling 140px on any scrollable page
      if (currentMaxScroll > 50 && currentScrollY > 140) {
        btn.classList.add('visible');
      } else {
        btn.classList.remove('visible');
      }

      if (currentMaxScroll <= 0) return;

      // 2. Calculate scroll ratio (0.0 to 1.0)
      const scrollRatio = Math.min(1, Math.max(0, currentScrollY / currentMaxScroll));

      // 3. Determine active segment index smoothly for both scroll UP & DOWN
      const rawIndex = scrollRatio * numSegments;
      const activeIndex = Math.min(numSegments - 1, Math.floor(rawIndex));

      // 4. Update segment colors dynamically (lights up on scroll DOWN, un-lights on scroll UP)
      segmentElements.forEach((el, idx) => {
        if (idx < activeIndex || (idx === activeIndex && scrollRatio > 0.02)) {
          // Passed or currently active segment -> Scarlet Red (#ee2626) with neon glow
          el.setAttribute('stroke', '#ee2626');
          el.style.filter = 'drop-shadow(0 0 6px rgba(238, 38, 38, 0.85))';
          el.style.opacity = '1';
        } else {
          // Inactive / unscrolled segment -> Dark Crimson (#380F15)
          el.setAttribute('stroke', '#380F15');
          el.style.filter = 'none';
          el.style.opacity = '0.65';
        }
      });
    }

    let ticking = false;
    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateScrollState();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      ({ maxScroll, clientHeight, scrollHeight } = getScrollableMetrics());
      onScroll();
    }, { passive: true });

    // Initial state check
    updateScrollState();

    // Scroll to Top action on center arrow / button body click
    btn.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).classList.contains('segment-arc')) return;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // Support Astro View Transitions & DOM Ready
  document.addEventListener('astro:page-load', initGranularProgressRing);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGranularProgressRing);
  } else {
    initGranularProgressRing();
  }
</script>
