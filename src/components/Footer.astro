---
interface Props {
  themeVariation?: 'convert' | 'logico';
}
const { themeVariation = 'convert' } = Astro.props;

const year = new Date().getFullYear();

const platformLinks = [
  { label: 'IT Consulting',       href: '/services/it-business-consulting' },
  { label: 'Strategic Planning',  href: '/services/strategic-planning' },
  { label: 'Operations',          href: '/services/operations-management' },
  { label: 'KPI Reporting',       href: '/services/kpi-reporting' },
];

const companyLinks = [
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Team',      href: '/team' },
  { label: 'Events',    href: '/events' },
  { label: 'Insights',  href: '/blog' },
  { label: 'Contact',   href: '/contact' },
];
---

<footer role="contentinfo">

  <!-- Upper Footer: Dark Obsidian -->
  <div class="footer-upper">
    <div class="container">
      <div class="footer-upper-grid">

        <!-- Brand column -->
        <div class="footer-brand">
          <a href="/" class="footer-brand-logo" aria-label="EDGE homepage">
            <span class="logo-glyph-sm" aria-hidden="true">
              <svg viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                <polygon points="9,1 17,5 17,13 9,17 1,13 1,5" fill="none" stroke="white" stroke-width="1.5"/>
                <polygon points="9,5 13,7 13,11 9,13 5,11 5,7" fill="white"/>
              </svg>
            </span>
            EDGE
          </a>
          <p class="footer-brand-tagline">
            Precision engineering for the high-stakes digital frontier.
          </p>
        </div>

        <!-- Platform column -->
        <div>
          <p class="footer-col-title">Platform</p>
          <nav class="footer-col-links" aria-label="Platform links">
            {platformLinks.map(link => (
              <a href={link.href}>{link.label}</a>
            ))}
          </nav>
        </div>

        <!-- Company column -->
        <div>
          <p class="footer-col-title">Company</p>
          <nav class="footer-col-links" aria-label="Company links">
            {companyLinks.map(link => (
              <a href={link.href}>{link.label}</a>
            ))}
          </nav>
        </div>

        <!-- Connect column -->
        <div>
          <p class="footer-col-title">Connect</p>
          <div class="footer-social-icons" aria-label="Social links">
            <!-- Twitter/X -->
            <a href="https://twitter.com" target="_blank" rel="noopener" class="footer-social-icon" aria-label="Twitter">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
            <!-- GitHub -->
            <a href="https://github.com" target="_blank" rel="noopener" class="footer-social-icon" aria-label="GitHub">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
            </a>
            <!-- Discord -->
            <a href="https://discord.com" target="_blank" rel="noopener" class="footer-social-icon" aria-label="Discord">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.032.056 2.052 1.508 4.041 2.423 5.993 3.029a.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.029.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
              </svg>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Lower Footer: White -->
  <div class="footer-lower">
    <div class="container">
      <div class="footer-lower-inner">
        <p>&copy; {year} <a href="/">EDGE Theme</a>. Built on <a href="https://pages.cloudflare.com" target="_blank" rel="noopener">Cloudflare Pages</a> &amp; Astro.</p>
        <div class="footer-status" aria-label="System status: operational">
          <span class="footer-status-dot" aria-hidden="true"></span>
          STATUS: OPERATIONAL
        </div>
      </div>
    </div>
  </div>

</footer>
