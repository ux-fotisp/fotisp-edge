---
// TeamShowcaseHome.astro — Modern Dribbble/Untitled UI Focus-Card Showcase Grid
import { getCollection } from 'astro:content';

const allTeam = (await getCollection('team'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 4);
---

<div class="team-showcase-container">
  <div class="team-focus-grid" id="team-focus-grid">
    {allTeam.map((member) => {
      const slug = (member as any).slug || member.id.replace(/\.mdx?$/, '');
      const imageSrc = member.data.avatar || member.data.photo || '/images/team/default-avatar.jpg';
      const location = member.data.location || 'UTC+2 // THESSALONIKI';
      const specialties = (member.data.specialties || []).slice(0, 3);
      
      return (
        <article class="team-focus-card" data-slug={slug} tabindex="0">
          <div class="team-focus-image-wrap">
            <img 
              src={imageSrc} 
              alt={member.data.name} 
              loading="lazy" 
              width="400" 
              height="500" 
              class="team-focus-img" 
            />
            <div class="team-focus-gradient-overlay"></div>
            <span class="team-focus-location-badge">
              <span class="badge-dot"></span>
              {location}
            </span>
          </div>

          <div class="team-focus-panel">
            <div class="team-focus-header">
              <span class="team-focus-dept">{member.data.department || 'ENGINEERING'}</span>
              <h3 class="team-focus-name">{member.data.name}</h3>
              <p class="team-focus-role">{member.data.role}</p>
            </div>

            {specialties.length > 0 && (
              <div class="team-focus-tags">
                {specialties.map((spec) => (
                  <span class="tech-pill">{spec}</span>
                ))}
              </div>
            )}

            <div class="team-focus-action">
              <a href={`/team/${slug}`} class="inspect-btn">
                INSPECT PROFILE <span class="arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</div>

<style>
  .team-showcase-container {
    width: 100%;
    margin-top: 40px;
  }

  .team-focus-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    position: relative;
  }

  @media (max-width: 1100px) {
    .team-focus-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .team-focus-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Base Focus Card Style */
  .team-focus-card {
    position: relative;
    background: var(--color-surface, #0F0909);
    border: 1px solid var(--color-border-deep, #380F15);
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
    height: 440px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    cursor: pointer;
    outline: none;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.4s ease,
                box-shadow 0.4s ease,
                opacity 0.4s ease,
                filter 0.4s ease;
  }

  /* Spotlight effect: when grid is hovered/focused, non-hovered siblings dim slightly */
  .team-focus-grid:hover .team-focus-card:not(:hover),
  .team-focus-grid:focus-within .team-focus-card:not(:focus-within) {
    opacity: 0.55;
    filter: brightness(0.7) grayscale(25%);
    transform: scale(0.98);
  }

  /* Active Hovered / Focused Card */
  .team-focus-card:hover,
  .team-focus-card:focus-within {
    opacity: 1 !important;
    filter: none !important;
    transform: translateY(-6px) scale(1.03) !important;
    border-color: rgba(238, 38, 38, 0.8) !important;
    box-shadow: 0 0 28px rgba(238, 38, 38, 0.45), 0 16px 40px rgba(0, 0, 0, 0.6) !important;
    z-index: 10;
  }

  /* Image Wrap */
  .team-focus-image-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: linear-gradient(135deg, #1A080B, #080303);
  }

  .team-focus-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .team-focus-card:hover .team-focus-img,
  .team-focus-card:focus-within .team-focus-img {
    transform: scale(1.08);
  }

  .team-focus-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(8, 3, 3, 0.2) 0%,
      rgba(8, 3, 3, 0.5) 45%,
      rgba(8, 3, 3, 0.95) 90%
    );
    transition: opacity 0.4s ease;
  }

  /* Timezone Location Badge */
  .team-focus-location-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #FFFFFF;
    background: rgba(8, 3, 3, 0.85);
    border: 1px solid rgba(238, 38, 38, 0.4);
    padding: 4px 10px;
    border-radius: 9999px;
    backdrop-filter: blur(8px);
    z-index: 2;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22C55E;
    box-shadow: 0 0 8px #22C55E;
  }

  /* Overlay Sliding Panel */
  .team-focus-panel {
    position: relative;
    z-index: 3;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transform: translateY(28px);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .team-focus-card:hover .team-focus-panel,
  .team-focus-card:focus-within .team-focus-panel {
    transform: translateY(0);
  }

  .team-focus-dept {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary, #ee2626);
    margin-bottom: 2px;
    display: block;
  }

  .team-focus-name {
    font-size: 1.25rem;
    font-weight: 900;
    color: #FFFFFF;
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .team-focus-role {
    font-size: 13px;
    color: var(--color-text-light, #9CA3AF);
    margin: 2px 0 0 0;
  }

  /* Tech Stack Pills */
  .team-focus-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    opacity: 0.85;
    transition: opacity 0.3s ease;
  }

  .team-focus-card:hover .team-focus-tags,
  .team-focus-card:focus-within .team-focus-tags {
    opacity: 1;
  }

  .tech-pill {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(238, 38, 38, 0.12);
    color: #F3F4F6;
    border: 1px solid rgba(238, 38, 38, 0.25);
  }

  /* Action CTA */
  .team-focus-action {
    margin-top: 4px;
    opacity: 0.9;
    transition: opacity 0.3s ease;
  }

  .team-focus-card:hover .team-focus-action,
  .team-focus-card:focus-within .team-focus-action {
    opacity: 1;
  }

  .inspect-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary, #ee2626);
    text-decoration: none;
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .inspect-btn:hover {
    gap: 10px;
    color: #FFFFFF;
  }
</style>
