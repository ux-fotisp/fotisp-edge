---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTitle from '../../components/PageTitle.astro';
import CTABand from '../../components/CTABand.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const teamMembers = await getCollection('team');
  return teamMembers.map(entry => ({
    params: { slug: (entry as any).slug || entry.id.replace(/\.mdx?$/, '') },
    props: { entry },
  }));
}

const { slug } = Astro.params;
const teamMembers = await getCollection('team');
const entry = Astro.props.entry || teamMembers.find(m => ((m as any).slug || m.id.replace(/\.mdx?$/, '')) === slug);

if (!entry) {
  return Astro.redirect('/team');
}

const { Content } = await render(entry);
const { name, role, department, avatar, photo, location, specialties, metrics, social, socials, officeHoursUrl } = entry.data;
const imageSrc = avatar || photo || '/images/team/default-avatar.jpg';
const activeSocials = socials || social;

// Cross-collection queries
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const memberPosts = allPosts.filter(p => 
  p.data.author && p.data.author.toLowerCase().includes(name.toLowerCase())
);

const allEvents = await getCollection('events', ({ data }) => !data.draft);
const memberEvents = allEvents.filter(e => 
  e.data.speakers && e.data.speakers.some(sp => sp.name.toLowerCase().includes(name.toLowerCase()))
);
---

<BaseLayout title={`${name} - ${role} | EDGE`} description={`Profile, research, and publications by ${name}, ${role} at EDGE.`}>

  {/* Scroll Progress Bar */}
  <div id="read-progress" class="read-progress-bar" aria-hidden="true"></div>

  <PageTitle 
    title={name} 
    breadcrumbs={[
      { label: 'TEAM', href: '/team' },
      { label: name.toUpperCase() }
    ]} 
  />

  <main class="main" id="site-content">
    <div class="container">
      
      <div class="content-sidebar">
        
        {/* Main 70% Profile Content */}
        <article class="single-team-profile">
          
          {/* Profile Header */}
          <header class="profile-header-card">
            <div class="profile-avatar-wrap">
              <img src={imageSrc} alt={name} class="profile-avatar-img" width="220" height="220" />
              <span class="profile-dept-badge">{department || 'ENGINEERING'}</span>
            </div>

            <div class="profile-header-info">
              <h1 class="profile-name">{name}</h1>
              <p class="profile-role">{role}</p>

              {location && (
                <div class="profile-location-pill">
                  <span class="location-dot"></span>
                  {location}
                </div>
              )}

              {activeSocials && (
                <div class="profile-social-links">
                  {activeSocials.github && (
                    <a href={activeSocials.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                      GitHub
                    </a>
                  )}
                  {activeSocials.linkedin && (
                    <a href={activeSocials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                      LinkedIn
                    </a>
                  )}
                  {activeSocials.twitter && (
                    <a href={activeSocials.twitter} target="_blank" rel="noopener noreferrer" aria-label="Twitter">
                      Twitter
                    </a>
                  )}
                  {activeSocials.scholar && (
                    <a href={activeSocials.scholar} target="_blank" rel="noopener noreferrer" aria-label="Google Scholar">
                      Scholar
                    </a>
                  )}
                </div>
              )}
            </div>
          </header>

          {/* Tech Stack & Metrics Bar */}
          {((specialties && specialties.length > 0) || (metrics && metrics.length > 0)) && (
            <div class="profile-meta-bar">
              {specialties && specialties.length > 0 && (
                <div class="profile-specialties-group">
                  <span class="meta-label">TECHNICAL SPECIALTIES</span>
                  <div class="specialties-pills">
                    {specialties.map(spec => (
                      <span class="spec-pill">{spec}</span>
                    ))}
                  </div>
                </div>
              )}

              {metrics && metrics.length > 0 && (
                <div class="profile-metrics-grid">
                  {metrics.map(met => (
                    <div class="metric-box">
                      <span class="metric-val">{met.value}</span>
                      <span class="metric-lbl">{met.label}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          )}

          {/* Body Entry Content */}
          <div class="entry-content">
            <Content />
          </div>

          {/* Authored Articles Cross-Feed */}
          {memberPosts.length > 0 && (
            <section class="member-feed-section">
              <h2 class="feed-title">Authored Technical Publications ({memberPosts.length})</h2>
              <div class="feed-list">
                {memberPosts.map(post => (
                  <a href={`/blog/${post.id.replace(/\.mdx?$/, '')}`} class="feed-item-card">
                    <span class="feed-date">{post.data.publishedAt || 'Published'}</span>
                    <h3 class="feed-item-title">{post.data.title}</h3>
                    {post.data.excerpt && <p class="feed-item-excerpt">{post.data.excerpt}</p>}
                  </a>
                ))}
              </div>
            </section>
          )}

          {/* Speaking Engagements Cross-Feed */}
          {memberEvents.length > 0 && (
            <section class="member-feed-section">
              <h2 class="feed-title">Speaking & Keynotes ({memberEvents.length})</h2>
              <div class="feed-list">
                {memberEvents.map(event => (
                  <a href={`/events/${event.id.replace(/\.mdx?$/, '')}`} class="feed-item-card event-feed-card">
                    <span class="feed-date">{event.data.eventDate || 'Upcoming'}</span>
                    <h3 class="feed-item-title">{event.data.title}</h3>
                    {event.data.tagline && <p class="feed-item-excerpt">{event.data.tagline}</p>}
                  </a>
                ))}
              </div>
            </section>
          )}

        </article>

        {/* Sticky 30% Sidebar */}
        <aside class="sidebar sticky top-24">
          
          <div class="widget briefing-widget">
            <h3 class="widget-title">Executive Briefing</h3>
            <p class="widget-desc">Schedule a 1-on-1 technical advisory session or request encrypted project documentation.</p>

            {officeHoursUrl && (
              <a href={officeHoursUrl} target="_blank" rel="noopener noreferrer" class="btn-briefing primary">
                BOOK OFFICE HOURS <span aria-hidden="true">→</span>
              </a>
            )}

            <a href="/contact" class="btn-briefing secondary">
              SEND ENCRYPTED MESSAGE
            </a>

            <div class="widget-telemetry-foot">
              <span class="telemetry-dot"></span>
              ENCRYPTION: AES-256-GCM
            </div>
          </div>

        </aside>

      </div>

    </div>
  </main>

  <CTABand 
    title="Want to collaborate with our team?" 
    description="Engage with our leadership and engineering architects to solve high-stakes infrastructure challenges." 
    primaryCtaText="GET IN TOUCH" 
    primaryCtaHref="/contact" 
  />

</BaseLayout>

<style>
  /* Read Progress Bar */
  .read-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: var(--color-primary, #ee2626);
    box-shadow: 0 0 10px var(--color-primary, #ee2626);
    width: 0%;
    z-index: 1000;
    transition: width 0.1s ease-out;
  }

  .content-sidebar {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 48px;
    align-items: start;
    margin-bottom: 80px;
  }

  @media (max-width: 992px) {
    .content-sidebar {
      grid-template-columns: 1fr;
    }
  }

  /* Sticky Sidebar */
  .sticky {
    position: sticky;
    top: 100px;
  }

  /* Profile Header */
  .profile-header-card {
    background: var(--color-surface, #0F0909);
    border: 1px solid var(--color-border-deep, #380F15);
    border-radius: var(--radius-md, 8px);
    padding: 32px;
    display: flex;
    gap: 32px;
    align-items: center;
    margin-bottom: 32px;
  }

  @media (max-width: 640px) {
    .profile-header-card {
      flex-direction: column;
      text-align: center;
    }
  }

  .profile-avatar-wrap {
    position: relative;
    width: 160px;
    height: 160px;
    flex-shrink: 0;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--color-primary, #ee2626);
    box-shadow: 0 0 20px rgba(238, 38, 38, 0.3);
  }

  .profile-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  .profile-dept-badge {
    position: absolute;
    bottom: 4px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--color-primary, #ee2626);
    background: rgba(8, 3, 3, 0.9);
    padding: 2px 8px;
    border-radius: 9999px;
    border: 1px solid rgba(238, 38, 38, 0.4);
    white-space: nowrap;
  }

  .profile-header-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .profile-name {
    font-size: 2rem;
    font-weight: 900;
    color: #FFFFFF;
    line-height: 1.1;
    margin: 0;
    letter-spacing: var(--tracking-tight);
  }

  .profile-role {
    font-size: 1.05rem;
    color: var(--color-text-light, #9CA3AF);
    margin: 0;
  }

  .profile-location-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #F3F4F6;
    background: rgba(238, 38, 38, 0.08);
    border: 1px solid rgba(238, 38, 38, 0.25);
    padding: 4px 12px;
    border-radius: 9999px;
    width: fit-content;
    margin-top: 4px;
  }

  .location-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22C55E;
    box-shadow: 0 0 8px #22C55E;
  }

  .profile-social-links {
    display: flex;
    gap: 10px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  .profile-social-links a {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-text-light, #9CA3AF);
    text-decoration: none;
    padding: 4px 10px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.2s ease;
  }

  .profile-social-links a:hover {
    color: #FFFFFF;
    background: rgba(238, 38, 38, 0.2);
    border-color: rgba(238, 38, 38, 0.4);
  }

  /* Meta Bar (Specialties + Metrics) */
  .profile-meta-bar {
    background: var(--color-surface, #0F0909);
    border: 1px solid var(--color-border-deep, #380F15);
    border-radius: var(--radius-md, 8px);
    padding: 24px 32px;
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .meta-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--color-primary, #ee2626);
    margin-bottom: 8px;
    display: block;
  }

  .specialties-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .spec-pill {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 4px 12px;
    border-radius: 4px;
    background: rgba(238, 38, 38, 0.12);
    color: #FFFFFF;
    border: 1px solid rgba(238, 38, 38, 0.3);
  }

  .profile-metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .metric-box {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .metric-val {
    font-size: 1.4rem;
    font-weight: 900;
    color: #FFFFFF;
  }

  .metric-lbl {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text-light, #9CA3AF);
    text-transform: uppercase;
  }

  /* Body Entry Content */
  .entry-content {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text-light, #D1D5DB);
    margin-bottom: 48px;
  }

  .entry-content h2,
  .entry-content h3 {
    color: #FFFFFF;
    font-weight: 800;
    margin-top: 32px;
    margin-bottom: 16px;
  }

  .entry-content blockquote {
    border-left: 3px solid var(--color-primary, #ee2626);
    padding-left: 20px;
    margin: 24px 0;
    font-style: italic;
    color: #FFFFFF;
    background: rgba(238, 38, 38, 0.05);
    padding: 16px 20px;
    border-radius: 0 8px 8px 0;
  }

  /* Feeds */
  .member-feed-section {
    margin-top: 48px;
    border-top: 1px solid var(--color-border-deep, #380F15);
    padding-top: 32px;
  }

  .feed-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 20px;
    letter-spacing: var(--tracking-tight);
  }

  .feed-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .feed-item-card {
    background: var(--color-surface, #0F0909);
    border: 1px solid var(--color-border-deep, #380F15);
    border-radius: var(--radius-md, 8px);
    padding: 20px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .feed-item-card:hover {
    border-color: var(--color-primary, #ee2626);
    transform: translateX(4px);
    box-shadow: 0 0 16px rgba(238, 38, 38, 0.2);
  }

  .feed-date {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--color-primary, #ee2626);
    text-transform: uppercase;
    margin-bottom: 4px;
    display: block;
  }

  .feed-item-title {
    font-size: 1rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 6px 0;
  }

  .feed-item-excerpt {
    font-size: 13px;
    color: var(--color-text-light, #9CA3AF);
    margin: 0;
    line-height: 1.5;
  }

  /* Sidebar Widget */
  .briefing-widget {
    background: var(--color-surface, #0F0909);
    border: 1px solid var(--color-border-deep, #380F15);
    border-radius: var(--radius-md, 8px);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .widget-title {
    font-size: 1.1rem;
    font-weight: 900;
    color: #FFFFFF;
    margin: 0;
  }

  .widget-desc {
    font-size: 13px;
    color: var(--color-text-light, #9CA3AF);
    line-height: 1.6;
    margin: 0;
  }

  .btn-briefing {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 12px;
    border-radius: 6px;
    text-align: center;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .btn-briefing.primary {
    background: var(--color-primary, #ee2626);
    color: #FFFFFF;
  }

  .btn-briefing.primary:hover {
    box-shadow: 0 0 16px rgba(238, 38, 38, 0.5);
    gap: 10px;
  }

  .btn-briefing.secondary {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #F3F4F6;
  }

  .btn-briefing.secondary:hover {
    background: rgba(238, 38, 38, 0.12);
    border-color: rgba(238, 38, 38, 0.3);
    color: #FFFFFF;
  }

  .widget-telemetry-foot {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--color-text-light, #9CA3AF);
    margin-top: 8px;
  }

  .telemetry-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #22C55E;
  }
</style>

<script>
  // Scroll progress bar calculation
  const bar = document.getElementById('read-progress');
  if (bar) {
    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      bar.style.width = Math.min(100, Math.max(0, scrolled)) + '%';
    }, { passive: true });
  }
</script>
