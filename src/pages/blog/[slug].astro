---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTitle from '../../components/PageTitle.astro';
import NewsCard from '../../components/NewsCard.astro';
import CTABand from '../../components/CTABand.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  let news = [];
  try {
    news = await getCollection('news');
  } catch (e) {
    news = [];
  }

  const postPaths = posts.map(entry => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '') },
    props: { entry, isNews: false },
  }));

  const newsPaths = news.map(entry => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '') },
    props: { entry, isNews: true },
  }));

  return [...postPaths, ...newsPaths];
}

const { slug } = Astro.params;
const allPosts = await getCollection('posts');
let allNews = [];
try {
  allNews = await getCollection('news');
} catch (e) {
  allNews = [];
}

const entry = Astro.props.entry || 
  allPosts.find(p => p.id.replace(/\.mdx?$/, '') === slug) || 
  allNews.find(n => n.id.replace(/\.mdx?$/, '') === slug);

if (!entry) {
  return Astro.redirect('/blog');
}

const { Content } = await render(entry);
const data = entry.data;

const title = data.title;
const tagline = data.tagline || data.excerpt || 'Technical analysis & infrastructure insights.';
const pubDate = data.pubDate || data.publishedAt || '2026-08-01';
const category = data.category || (data.categories && data.categories[0]) || 'THOUGHT LEADERSHIP';
const author = data.author || 'EDGE Intelligence Team';
const readingTime = data.readingTime || '4 min read';
const featuredImage = data.featuredImage;
const tags = data.tags || data.categories || ['EDGE', 'INFRASTRUCTURE'];

const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Related articles (excluding current)
const relatedArticles = [...allNews, ...allPosts]
  .filter(item => item.id !== entry.id)
  .slice(0, 3);
---

<BaseLayout 
  title={data.seo?.seoTitle || title} 
  description={data.seo?.metaDescription || tagline}
  ogImage={data.seo?.ogImage || featuredImage}
  noindex={data.seo?.noindex}
  type="article"
  publishedDate={pubDate}
  author={author}
  schemaType="article"
  schemaData={data}
  breadcrumbs={[
    { name: 'Home', item: '/' },
    { name: 'Blog', item: '/blog' },
    { name: title, item: Astro.url.pathname }
  ]}
>
  {/* System Status Indicator: Fixed top scroll progress bar */}
  <div id="read-progress" class="read-progress-bar" aria-hidden="true"></div>

  <PageTitle 
    title={title} 
    breadcrumbs={[
      { label: 'NEWS', href: '/blog' },
      { label: String(category).toUpperCase() }
    ]} 
  />

  <main class="main news-detail-main" id="site-content">
    <div class="container">
      
      {/* Article Header (Centered ~70% max-width) */}
      <header class="article-header-container">
        <div class="article-meta-badge-bar">
          <span class="category-badge">{category}</span>
          <span class="meta-dot">•</span>
          <time datetime={new Date(pubDate).toISOString()}>{formattedDate}</time>
          <span class="meta-dot">•</span>
          <span>{readingTime}</span>
        </div>

        <h1 class="article-main-title">{title}</h1>
        <p class="article-main-tagline">{tagline}</p>

        <div class="article-author-row">
          <div class="author-avatar-placeholder">
            <span class="author-initials">{author.charAt(0)}</span>
          </div>
          <div class="author-details">
            <span class="author-title">{author}</span>
            <span class="author-sub">EDGE Intelligence Operations</span>
          </div>
        </div>
      </header>

      {/* Featured Banner Image if available */}
      {featuredImage && (
        <div class="article-featured-banner">
          <img src={featuredImage} alt={title} class="article-banner-img" />
        </div>
      )}

      {/* Prose Reading Container (Constrained max-width: 720px centered) */}
      <article class="article-prose-container">
        <div class="entry-content news-mdx-prose">
          <Content />
        </div>

        {/* Article Footer: Tag pills, Copy URL, Social Shares */}
        <footer class="article-footer">
          <div class="article-tags-row">
            <span class="tags-label">TAGS:</span>
            {tags.map(tag => (
              <span class="news-tag-pill">#{String(tag).toLowerCase()}</span>
            ))}
          </div>

          <div class="article-actions-row">
            <button type="button" id="copy-url-btn" class="article-action-btn">
              <span class="btn-icon">🔗</span> COPY LINK
            </button>
            <a 
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(`https://fotisp.gr/blog/${slug}`)}`}
              target="_blank" 
              rel="noopener noreferrer" 
              class="article-action-btn"
            >
              SHARE ON X
            </a>
            <a 
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://fotisp.gr/blog/${slug}`)}`}
              target="_blank" 
              rel="noopener noreferrer" 
              class="article-action-btn"
            >
              SHARE ON LINKEDIN
            </a>
          </div>
          <p id="copy-status" class="copy-status-msg" aria-live="polite"></p>
        </footer>
      </article>

      {/* Related Articles Section (Bottom 3-column grid) */}
      {relatedArticles.length > 0 && (
        <section class="related-news-section" aria-label="Related Intelligence Articles">
          <h2 class="related-section-title">RELATED INTELLIGENCE</h2>
          <div class="related-news-grid">
            {relatedArticles.map(art => {
              const artData = art.data as any;
              return (
                <NewsCard
                  title={artData.title}
                  slug={`/blog/${art.id.replace(/\.mdx?$/, '')}`}
                  tagline={artData.tagline || artData.excerpt || 'Technical analysis'}
                  pubDate={artData.pubDate || artData.publishedAt || '2026-08-01'}
                  category={artData.category || (artData.categories && artData.categories[0]) || 'THOUGHT LEADERSHIP'}
                  author={artData.author || 'EDGE Intelligence Team'}
                  readingTime={artData.readingTime || '4 min read'}
                  featuredImage={artData.featuredImage}
                />
              );
            })}
          </div>
        </section>
      )}

    </div>
  </main>

  <CTABand 
    title="Questions regarding this release?" 
    description="Contact our press office or infrastructure engineering team directly." 
    primaryCtaText="CONTACT INTELLIGENCE TEAM" 
    primaryCtaHref="/contact" 
  />
</BaseLayout>

<style>
  /* Fixed top reading progress bar */
  .read-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: var(--color-scarlet-red, #ee2626);
    box-shadow: 0 0 10px var(--color-scarlet-red, #ee2626);
    width: 0%;
    z-index: 1000;
    transition: width 0.1s ease-out;
  }

  .news-detail-main {
    background: var(--color-obsidian, #080303);
    padding-bottom: 80px;
  }

  /* Centered Article Header (~70% max-width) */
  .article-header-container {
    max-width: 800px;
    margin: 0 auto 40px auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .article-meta-badge-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #9CA3AF;
  }

  .category-badge {
    font-family: monospace;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-scarlet-red, #ee2626);
    background: rgba(238, 38, 38, 0.1);
    border: 1px solid rgba(238, 38, 38, 0.3);
    padding: 4px 12px;
    border-radius: 9999px;
  }

  .meta-dot {
    color: var(--color-border-deep, #380F15);
  }

  .article-main-title {
    font-size: 2.2rem;
    font-weight: 900;
    color: #FFFFFF;
    line-height: 1.25;
    letter-spacing: var(--tracking-tight, -0.02em);
    margin: 0;
  }

  .article-main-tagline {
    font-size: 1.15rem;
    color: #D1D5DB;
    line-height: 1.6;
    margin: 0;
  }

  .article-author-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
  }

  .author-avatar-placeholder {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(238, 38, 38, 0.15);
    border: 1px solid var(--color-scarlet-red, #ee2626);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    font-weight: 800;
    font-size: 14px;
  }

  .author-details {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .author-title {
    font-size: 13px;
    font-weight: 700;
    color: #FFFFFF;
  }

  .author-sub {
    font-size: 11px;
    color: #9CA3AF;
  }

  /* Featured Banner Image */
  .article-featured-banner {
    max-width: 960px;
    margin: 0 auto 48px auto;
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
    border: 1px solid var(--color-border-deep, #380F15);
  }

  .article-banner-img {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
  }

  /* Constrained 720px Reader Column */
  .article-prose-container {
    max-width: 720px;
    margin: 0 auto;
  }

  .news-mdx-prose {
    font-size: 1.05rem;
    line-height: 1.85;
    color: #D1D5DB;
  }

  .news-mdx-prose h2,
  .news-mdx-prose h3 {
    color: #FFFFFF;
    margin-top: 36px;
    margin-bottom: 16px;
    font-weight: 800;
  }

  /* Blockquote styling with 4px left border in #ee2626 & background in #1A080B */
  .news-mdx-prose blockquote {
    background: var(--color-burgundy, #1A080B);
    border-left: 4px solid var(--color-scarlet-red, #ee2626);
    border-top: 1px solid var(--color-border-deep, #380F15);
    border-right: 1px solid var(--color-border-deep, #380F15);
    border-bottom: 1px solid var(--color-border-deep, #380F15);
    border-radius: 0 var(--radius-md, 8px) var(--radius-md, 8px) 0;
    padding: 24px 28px;
    margin: 32px 0;
    color: #FFFFFF;
    font-size: 1.1rem;
    font-style: italic;
    line-height: 1.7;
  }

  /* Article Footer */
  .article-footer {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--color-border-deep, #380F15);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .article-tags-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .tags-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #9CA3AF;
  }

  .news-tag-pill {
    font-family: monospace;
    font-size: 11px;
    color: var(--color-scarlet-red, #ee2626);
    background: rgba(238, 38, 38, 0.08);
    border: 1px solid rgba(238, 38, 38, 0.25);
    padding: 3px 10px;
    border-radius: 9999px;
  }

  .article-actions-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .article-action-btn {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #FFFFFF;
    background: var(--color-surface, #0F0909);
    border: 1px solid var(--color-border-deep, #380F15);
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .article-action-btn:hover {
    border-color: var(--color-scarlet-red, #ee2626);
    color: var(--color-scarlet-red, #ee2626);
    box-shadow: 0 0 12px rgba(238, 38, 38, 0.2);
  }

  .copy-status-msg {
    font-size: 11px;
    color: #10B981;
    margin: 0;
    min-height: 16px;
  }

  /* Related Articles Section */
  .related-news-section {
    margin-top: 80px;
    padding-top: 48px;
    border-top: 1px solid var(--color-border-deep, #380F15);
  }

  .related-section-title {
    font-size: 1.4rem;
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: 28px;
    letter-spacing: var(--tracking-tight, -0.02em);
  }

  .related-news-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  @media (max-width: 992px) {
    .related-news-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .related-news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Scroll progress bar calculation
  const bar = document.getElementById('read-progress');
  if (bar) {
    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      bar.style.width = Math.min(100, Math.max(0, scrolled)) + '%';
    }, { passive: true });
  }

  // Copy URL button
  const copyBtn = document.getElementById('copy-url-btn');
  const copyStatus = document.getElementById('copy-status');

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (copyStatus) {
        copyStatus.textContent = '✓ Article link copied to clipboard!';
        setTimeout(() => {
          copyStatus.textContent = '';
        }, 3000);
      }
    } catch (err) {
      if (copyStatus) {
        copyStatus.textContent = 'Copied: ' + window.location.href;
      }
    }
  });
</script>
