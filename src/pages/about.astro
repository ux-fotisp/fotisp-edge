---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import CTABand from '../components/CTABand.astro';

const visualLabProjects = [
  {
    title: "emDash CMS Interface",
    category: "SYSTEMS DESIGN",
    description: "Component-driven publishing dashboard and edge content management interface engineered for Cloudflare Workers.",
    image: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=800&auto=format&fit=crop",
    link: "https://fotisp.gr",
    tags: ["Astro 5", "Cloudflare D1", "TypeScript", "Pure CSS"]
  },
  {
    title: "Telemetry & Performance Dashboard",
    category: "HIGH-DENSITY UX",
    description: "Real-time telemetry monitoring suite designed with sub-millisecond user feedback, GPU-promoted light trails, and dark obsidian aesthetic.",
    image: "https://images.unsplash.com/photo-1558494949-ef010cbdcc31?q=80&w=800&auto=format&fit=crop",
    link: "https://fotisp.gr",
    tags: ["Systems Design", "Micro-Interactions", "Canvas 2D", "OOUX"]
  },
  {
    title: "EDGE Design System & Token Engine",
    category: "DESIGN SYSTEM",
    description: "Zero-dependency CSS custom properties token hierarchy, fluid typography scale, and accessible WCAG AA contrast combinations.",
    image: "https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?q=80&w=800&auto=format&fit=crop",
    link: "https://fotisp.gr",
    tags: ["CSS Tokens", "Design Tokens", "Figma", "Accessibility"]
  }
];

const articles = [
  {
    title: "24 Hours, One Idea: How Fast UX Can Move",
    category: "RAPID PROTOTYPING",
    readTime: "3 MIN READ",
    excerpt: "Exploring how eliminating backend friction and utilizing token-driven CSS allows designers to move from concept to edge deployment in under 24 hours.",
    date: "Aug 08, 2026",
    link: "/blog"
  },
  {
    title: "Building with emDash: A Hybrid Designer's Perspective",
    category: "ARCHITECTURAL NOTES",
    readTime: "5 MIN READ",
    excerpt: "Architectural insights into engineering a decoupled content management system natively integrated with Cloudflare D1 and Astro Content Layer.",
    date: "Jul 24, 2026",
    link: "/blog"
  },
  {
    title: "Architecting fotisp-edge: Performance-First Web Design",
    category: "ENGINEERING",
    readTime: "4 MIN READ",
    excerpt: "Deep dive into zero-dependency CSS tokens, Don Norman heuristic signifiers, and 60fps micro-interaction engineering for global edge CDNs.",
    date: "Jul 12, 2026",
    link: "/blog"
  }
];

const techStack = [
  { name: "Astro 5", category: "Front-End Framework" },
  { name: "Pure CSS Tokens", category: "Styling & Architecture" },
  { name: "TypeScript", category: "Language" },
  { name: "Cloudflare Workers", category: "Edge Serverless" },
  { name: "Cloudflare D1 (SQLite)", category: "Database" },
  { name: "Cloudflare R2", category: "Object Storage" },
  { name: "Zod Schemas", category: "Type Validation" },
  { name: "GSAP & Lottie", category: "Micro-Animations" },
  { name: "Figma & Systems Design", category: "UX & Systems" },
  { name: "OOUX Framework", category: "Information Architecture" },
  { name: "emDash CMS", category: "Content Engine" },
  { name: "WCAG AA Compliance", category: "Accessibility" }
];

const methodology = [
  {
    step: "01",
    title: "AUDIT & DISCOVERY",
    description: "Analyzing product parameters, OOUX object modeling, user mental models, and telemetry specifications."
  },
  {
    step: "02",
    title: "PROTOTYPE & TOKENS",
    description: "Building component libraries, pure CSS tokens, and 60fps micro-interactions directly in Figma and code."
  },
  {
    step: "03",
    title: "BUILD & OPTIMIZE",
    description: "Engineering cleanly structured Astro & TypeScript front-ends with sub-millisecond execution and zero layout thrashing."
  },
  {
    step: "04",
    title: "EDGE DEPLOYMENT",
    description: "Deploying to Cloudflare Workers, D1 SQLite databases, and global edge CDN nodes with 100% Core Web Vitals."
  }
];
---

<BaseLayout
  title="About Fotis Pastrakis | UX Architect & Web Engineer"
  description="Lead UX Designer & Web Engineer bridging high-density systems design, edge serverless architecture, and micro-interactions."
>
  {/* Scroll Progress Bar */}
  <div id="read-progress" class="read-progress-bar" aria-hidden="true"></div>

  <PageTitle
    title="Architecting at the Edge"
    subtitle="Lead UX Designer & Web Engineer bridging systems design with serverless performance."
    breadcrumbs={[{ label: 'ABOUT' }]}
  />

  <main class="main about-page-main" id="site-content">
    <div class="container space-y-24">

      <!-- ═══════════════════════════════════════════════════════
           SECTION 1: 70/30 SPLIT (EXECUTIVE BIO & PROFILE)
      ════════════════════════════════════════════════════════ -->
      <section id="bio-intro" class="section-70-30" aria-label="Executive Bio and Profile">
        
        <!-- Main Column (70%) -->
        <article class="bio-main-col">
          <div class="section-badge-bar">
            <span class="category-badge">UX ARCHITECT & WEB ENGINEER</span>
          </div>

          <h2 class="bio-headline">
            Designing for humans. Engineering for the edge.
          </h2>

          <div class="bio-prose">
            <p>
              I am <strong>Fotis Pastrakis</strong>, a Lead UX Designer and Web Engineer specializing in high-density digital products, component-driven design systems, and serverless web architecture. Operating at the intersection of human-computer interaction (HCI) and edge computing, I build software that feels instantaneous, visually arresting, and effortless to navigate.
            </p>
            <p>
              My personal portfolio and laboratory at <a href="https://fotisp.gr" target="_blank" rel="noopener noreferrer" class="bio-link">fotisp.gr</a> serves as an open workspace for testing the limits of modern web development. It is where I experiment with decoupled CMS engines (like <strong>emDash</strong>), custom CSS token systems, sub-millisecond edge routing, and Don Norman’s UX heuristics.
            </p>

            <!-- Design Philosophy Quote Box -->
            <blockquote class="philosophy-quote-box">
              <span class="quote-symbol">“</span>
              <p class="quote-text">
                Removing backend friction so UX can move at the speed of an idea.
              </p>
              <footer class="quote-author">— Fotis Pastrakis, Design Philosophy</footer>
            </blockquote>

            <p>
              Whether architecting enterprise SaaS control planes or prototyping zero-dependency design systems, my commitment remains constant: clean typography, 60fps GPU-accelerated micro-interactions, and 100% Core Web Vitals compliance on global edge networks.
            </p>
          </div>

          <!-- Direct Link Button: VISIT FOTISP.GR -->
          <div class="bio-actions">
            <a href="https://fotisp.gr" target="_blank" rel="noopener noreferrer" class="btn visit-fotisp-btn" id="visit-fotisp-btn">
              VISIT FOTISP.GR <span class="btn-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </article>

        <!-- Sidebar Column (30% - Sticky top-24) -->
        <aside class="bio-sidebar sticky-sidebar">
          <div class="profile-card">
            <div class="profile-avatar-wrapper">
              <img 
                src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=400&auto=format&fit=crop" 
                alt="Fotis Pastrakis" 
                class="profile-avatar-img"
                width="200"
                height="200"
              />
              <span class="status-pulse-dot" title="Available for advisory & engineering"></span>
            </div>

            <h3 class="profile-name">Fotis Pastrakis</h3>
            <p class="profile-role">Lead UX Designer & Web Engineer</p>

            <div class="profile-location-tag">
              <span class="loc-icon">📍</span>
              <span>UTC+2 // THESSALONIKI, GREECE</span>
            </div>

            <div class="profile-social-list">
              <a href="mailto:fotispastrakis@gmail.com" class="social-item">
                <span class="social-icon">✉️</span> fotispastrakis@gmail.com
              </a>
              <a href="tel:+306989697150" class="social-item">
                <span class="social-icon">📞</span> +30 69 89 69 7150
              </a>
              <a href="https://github.com/ux-fotisp" target="_blank" rel="noopener noreferrer" class="social-item">
                <span class="social-icon">💻</span> GitHub / ux-fotisp
              </a>
              <a href="https://fotisp.gr" target="_blank" rel="noopener noreferrer" class="social-item">
                <span class="social-icon">🌐</span> fotisp.gr
              </a>
            </div>
          </div>
        </aside>

      </section>

      <!-- ═══════════════════════════════════════════════════════
           SECTION 2: 100% FULL-WIDTH (VISUAL LAB & WORK SHOWCASE)
      ════════════════════════════════════════════════════════ -->
      <section id="visual-showcase" class="section-fullwidth" aria-label="Visual Lab Showcase">
        <div class="section-header-centered">
          <span class="category-badge">EXPERIMENTAL LAB</span>
          <h2 class="section-title">Visual Lab & Selected Interfaces</h2>
          <p class="section-subtitle">
            Explorations in component architecture, high-density telemetry dashboards, and micro-interactions from fotisp.gr.
          </p>
        </div>

        <div class="visual-gallery-grid">
          {visualLabProjects.map((project) => (
            <article class="visual-card">
              <div class="visual-card-image-wrap">
                <img src={project.image} alt={project.title} class="visual-card-img" loading="lazy" />
                <div class="visual-card-overlay">
                  <a href={project.link} target="_blank" rel="noopener noreferrer" class="visual-preview-link">
                    EXPLORE LAB <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>

              <div class="visual-card-content">
                <span class="visual-card-category">{project.category}</span>
                <h3 class="visual-card-title">
                  <a href={project.link} target="_blank" rel="noopener noreferrer">
                    {project.title}
                  </a>
                </h3>
                <p class="visual-card-desc">{project.description}</p>
                
                <div class="visual-card-tags">
                  {project.tags.map((tag) => (
                    <span class="tag-pill">{tag}</span>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- ═══════════════════════════════════════════════════════
           SECTION 3: 70/30 SPLIT (TECH STACK & TOOLING ARCHITECTURE)
      ════════════════════════════════════════════════════════ -->
      <section id="stack-architecture" class="section-70-30" aria-label="Tech Stack and Tooling Architecture">
        
        <!-- Main Column (70%) -->
        <div class="stack-main-col">
          <div class="section-badge-bar">
            <span class="category-badge">SYSTEMS ARCHITECTURE</span>
          </div>

          <h2 class="section-title-left">Tech Stack & Tooling Architecture</h2>
          <p class="section-desc-left">
            A curated stack selected for maximum execution speed, zero cold starts, and zero layout shift.
          </p>

          <div class="stack-categories-grid">
            <!-- Group 1: Design & UX -->
            <div class="stack-group-card">
              <div class="group-header">
                <span class="group-icon">🎨</span>
                <h3 class="group-title">Design & UX Systems</h3>
              </div>
              <p class="group-desc">Figma, Systems Design, HCI Principles, Component-Driven Prototyping, OOUX, Usability Testing.</p>
            </div>

            <!-- Group 2: Front-End Engineering -->
            <div class="stack-group-card">
              <div class="group-header">
                <span class="group-icon">⚡</span>
                <h3 class="group-title">Front-End Engineering</h3>
              </div>
              <p class="group-desc">Astro 5, Pure CSS Custom Property Tokens, TypeScript, GSAP, Lottie, Semantic HTML5.</p>
            </div>

            <!-- Group 3: Edge & Serverless -->
            <div class="stack-group-card">
              <div class="group-header">
                <span class="group-icon">☁️</span>
                <h3 class="group-title">Edge & Serverless Infrastructure</h3>
              </div>
              <p class="group-desc">Cloudflare Workers, D1 SQLite Database, R2 Object Storage, Zod Schemas, emDash CMS.</p>
            </div>
          </div>

          <!-- Interactive Stack Matrix -->
          <div class="stack-matrix-wrap">
            <h4 class="matrix-title">INTERACTIVE STACK MATRIX</h4>
            <div class="stack-matrix-grid">
              {techStack.map((tech) => (
                <div class="matrix-pill">
                  <span class="matrix-tech-name">{tech.name}</span>
                  <span class="matrix-tech-cat">{tech.category}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar Column (30% - Sticky top-24) -->
        <aside class="stack-sidebar sticky-sidebar">
          <div class="quick-stats-card">
            <h3 class="stats-card-title">Performance Metrics</h3>

            <div class="stat-item">
              <span class="stat-value">10+ YRS</span>
              <span class="stat-label">UX & ENGINEERING EXP</span>
            </div>

            <div class="stat-divider"></div>

            <div class="stat-item">
              <span class="stat-value">100%</span>
              <span class="stat-label">CORE WEB VITALS SCORE</span>
            </div>

            <div class="stat-divider"></div>

            <div class="stat-item">
              <span class="stat-value">0ms</span>
              <span class="stat-label">COLD START OVERHEAD</span>
            </div>

            <div class="stat-divider"></div>

            <div class="stat-item">
              <span class="stat-value">&lt; 1ms</span>
              <span class="stat-label">EDGE ROUTING LATENCY</span>
            </div>

            <div class="stats-footer-status">
              <span class="status-dot-green"></span>
              VERIFIED CORE PERFORMANCE
            </div>
          </div>
        </aside>

      </section>

      <!-- ═══════════════════════════════════════════════════════
           SECTION 4: 100% FULL-WIDTH (THOUGHT LEADERSHIP & WRITING)
      ════════════════════════════════════════════════════════ -->
      <section id="featured-writing" class="section-fullwidth" aria-label="Featured Articles and Writing">
        <div class="section-header-centered">
          <span class="category-badge">THOUGHT LEADERSHIP</span>
          <h2 class="section-title">Articles & Field Notes</h2>
          <p class="section-subtitle">
            Essays on rapid product prototyping, serverless architecture, and performance-first design.
          </p>
        </div>

        <div class="articles-grid">
          {articles.map((article) => (
            <article class="article-card">
              <div class="article-card-head">
                <span class="article-category">{article.category}</span>
                <span class="article-read-time">{article.readTime}</span>
              </div>

              <h3 class="article-title">
                <a href={article.link}>
                  {article.title}
                </a>
              </h3>

              <p class="article-excerpt">{article.excerpt}</p>

              <div class="article-footer">
                <span class="article-date">{article.date}</span>
                <a href={article.link} class="article-read-btn">
                  READ ESSAY <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- ═══════════════════════════════════════════════════════
           SECTION 5: 70/30 SPLIT (EXECUTION PIPELINE & BRIEFING)
      ════════════════════════════════════════════════════════ -->
      <section id="execution-pipeline" class="section-70-30" aria-label="Execution Pipeline and Methodology">
        
        <!-- Main Column (70%) -->
        <div class="pipeline-main-col">
          <div class="section-badge-bar">
            <span class="category-badge">METHODOLOGY</span>
          </div>

          <h2 class="section-title-left">4-Step Execution Pipeline</h2>
          <p class="section-desc-left">
            How ideas transition from raw UX requirements to global edge deployment without compromise.
          </p>

          <div class="methodology-grid">
            {methodology.map((m) => (
              <div class="methodology-card">
                <span class="methodology-step">{m.step}</span>
                <h3 class="methodology-title">{m.title}</h3>
                <p class="methodology-desc">{m.description}</p>
              </div>
            ))}
          </div>

          <!-- Engineering Commitment Callout -->
          <div class="commitment-box">
            <h4 class="commitment-title">ENGINEERING COMMITMENT</h4>
            <p class="commitment-text">
              Every interface shipped adherence strictly to 100% WCAG AA accessibility, zero layout thrashing, pure CSS design tokens, and GPU-promoted CSS transitions for 60fps fluidity across all devices.
            </p>
          </div>
        </div>

        <!-- Sidebar Column (30% - Sticky top-24) -->
        <aside class="pipeline-sidebar sticky-sidebar">
          <div class="action-widget-card">
            <div class="action-widget-badge">COLLABORATION</div>
            <h3 class="action-widget-title">Initiate Project Briefing</h3>
            <p class="action-widget-desc">
              Ready to engineer your next digital platform, scope custom design tokens, or consult on UX architecture?
            </p>

            <a href="/contact" class="btn action-widget-btn">
              START A PROJECT <span aria-hidden="true">→</span>
            </a>

            <div class="action-widget-foot">
              <span class="status-dot-green"></span>
              DIRECT RESPONSE &lt; 4 HOURS
            </div>
          </div>
        </aside>

      </section>

    </div>
  </main>

  <CTABand
    title="Want to build together?"
    subtitle="Let's engineer your high-throughput platform or prototype your next digital product."
    buttonLabel="INITIATE BRIEFING"
    buttonUrl="/contact"
    variant="scarlet"
  />
</BaseLayout>

<style>
  /* Fixed Top Reading Progress Bar */
  .read-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: var(--color-scarlet-red, #ee2626);
    box-shadow: 0 0 12px var(--color-scarlet-red, #ee2626);
    width: 0%;
    z-index: 1000;
    transition: width 0.1s ease-out;
  }

  .about-page-main {
    background: var(--color-obsidian, #080303);
    padding-bottom: 96px;
  }

  .space-y-24 > * + * {
    margin-top: 96px;
  }

  /* 70/30 Split Layout Grid */
  .section-70-30 {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 48px;
    align-items: start;
  }

  @media (max-width: 992px) {
    .section-70-30 {
      grid-template-columns: 1fr;
    }
  }

  /* Sticky Sidebar (top-24 / 100px) */
  .sticky-sidebar {
    position: sticky;
    top: 100px;
  }

  /* Common Category Badge */
  .category-badge {
    font-family: monospace;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-scarlet-red, #ee2626);
    background: rgba(238, 38, 38, 0.1);
    border: 1px solid rgba(238, 38, 38, 0.3);
    padding: 4px 12px;
    border-radius: 9999px;
    display: inline-block;
    margin-bottom: 12px;
  }

  /* Section Titles */
  .bio-headline,
  .section-title-left {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 900;
    color: #FFFFFF;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 20px 0;
  }

  .section-desc-left {
    font-size: 1.1rem;
    color: #D1D5DB;
    line-height: 1.6;
    margin-bottom: 32px;
  }

  /* Executive Bio Prose */
  .bio-prose {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #D1D5DB;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .bio-prose strong {
    color: #FFFFFF;
  }

  .bio-link {
    color: var(--color-scarlet-red, #ee2626);
    text-decoration: none;
    font-weight: 700;
    transition: color 0.2s ease;
  }

  .bio-link:hover {
    color: #EF4444;
    text-decoration: underline;
  }

  /* Philosophy Quote Box */
  .philosophy-quote-box {
    background: var(--color-burgundy, #1A080B);
    border-left: 4px solid var(--color-scarlet-red, #ee2626);
    border-top: 1px solid var(--color-border-deep, #380F15);
    border-right: 1px solid var(--color-border-deep, #380F15);
    border-bottom: 1px solid var(--color-border-deep, #380F15);
    border-radius: 0 8px 8px 0;
    padding: 28px 32px;
    margin: 16px 0;
    position: relative;
  }

  .quote-symbol {
    font-size: 3rem;
    line-height: 1;
    color: var(--color-scarlet-red, #ee2626);
    opacity: 0.3;
    position: absolute;
    top: 12px;
    left: 16px;
  }

  .quote-text {
    font-size: 1.2rem;
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.5;
    margin: 0 0 12px 0;
    position: relative;
    z-index: 1;
  }

  .quote-author {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--color-scarlet-red, #ee2626);
    text-transform: uppercase;
  }

  /* Direct Link Button: VISIT FOTISP.GR */
  .bio-actions {
    margin-top: 32px;
  }

  .visit-fotisp-btn {
    background: var(--color-scarlet-red, #ee2626);
    color: #FFFFFF;
    font-weight: 900;
    letter-spacing: 0.12em;
    padding: 14px 28px;
    border-radius: 6px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 0 20px rgba(238, 38, 38, 0.4);
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
  }

  .visit-fotisp-btn:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 0 28px rgba(238, 38, 38, 0.65);
    background: #EF4444;
  }

  .btn-arrow {
    font-size: 1.1rem;
    transition: transform 0.2s ease;
  }

  .visit-fotisp-btn:hover .btn-arrow {
    transform: translateX(4px);
  }

  /* Profile Card (Sidebar 1) */
  .profile-card {
    background: var(--color-surface, #0F0909);
    border: 1px solid var(--color-border-deep, #380F15);
    border-radius: 12px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .profile-avatar-wrapper {
    position: relative;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--color-scarlet-red, #ee2626);
    box-shadow: 0 0 20px rgba(238, 38, 38, 0.35);
    margin-bottom: 20px;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .profile-avatar-wrapper:hover {
    box-shadow: 0 0 30px rgba(238, 38, 38, 0.6);
    transform: scale(1.02);
  }

  .profile-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .status-pulse-dot {
    position: absolute;
    bottom: 8px;
    right: 8px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 10px #10B981;
    border: 2px solid #0F0909;
  }

  .profile-name {
    font-size: 1.3rem;
    font-weight: 900;
    color: #FFFFFF;
    margin: 0 0 4px 0;
  }

  .profile-role {
    font-size: 13px;
    color: #9CA3AF;
    margin: 0 0 16px 0;
  }

  .profile-location-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #F3F4F6;
    background: rgba(238, 38, 38, 0.08);
    border: 1px solid rgba(238, 38, 38, 0.25);
    padding: 6px 14px;
    border-radius: 9999px;
    margin-bottom: 20px;
  }

  .profile-social-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
