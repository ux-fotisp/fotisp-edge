---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CyberGridBg from '../components/CyberGridBg.astro';
import StatsBar from '../components/StatsBar.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ServiceShowcaseHome from '../components/ServiceShowcaseHome.astro';
import EventCard from '../components/EventCard.astro';
import TeamCard from '../components/TeamCard.astro';
import TeamShowcaseHome from '../components/TeamShowcaseHome.astro';
import AccessModal from '../components/AccessModal.astro';
import '../styles/homepage.css';

// Query Content Layer Collections (OOUX Object Collections)
const allEvents = await getCollection('events', ({ data }) => !data.draft);
const featuredEvents = allEvents
  .sort((a, b) => new Date(b.data.eventDate).getTime() - new Date(a.data.eventDate).getTime())
  .slice(0, 2);

const allServices = await getCollection('services', ({ data }) => !data.draft);
const featuredServices = allServices
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .slice(0, 3);

const allTeam = (await getCollection('team'))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// System Telemetry Data (Don Norman Usability Heuristic: System Status Visibility)
const telemetryStats = [
  { value: '99.99%', label: 'Uptime Reliability' },
  { value: '< 1ms', label: 'Edge TTFB Latency' },
  { value: '500+', label: 'Infrastructure Audits' },
  { value: '24/7', label: 'Autonomous Defense' },
];
---

<BaseLayout
  description="Evidence-based UX strategy, Object-Oriented UX architectures, and high-density web systems by Fotis Pastrakis."
  schemaType="home"
  themeVariation="convert"
  bodyClass="home"
>
<main id="site-content">
  <!-- ═══════════════════════════════════════════════════════
       HERO SECTION
  ════════════════════════════════════════════════════════ -->
  <section id="hero" class="hero-edge" aria-label="Hero">
    <!-- Cyber Grid Canvas with Horizontal & Vertical Red Light Trails -->
    <CyberGridBg gridSize={60} speed={1.2} />

    <!-- Decorative animated orbs -->
    <div class="hero-orb hero-orb-1" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-2" aria-hidden="true"></div>
    <!-- Laser trails -->
    <div class="hero-laser hero-laser-1" aria-hidden="true"></div>
    <div class="hero-laser hero-laser-2" aria-hidden="true"></div>
    <div class="hero-laser hero-laser-3" aria-hidden="true"></div>

    <div class="container">
      <div class="hero-edge-content">
        <!-- System Online badge -->
        <div class="system-badge" aria-label="Open Source EmDash Template by Fotis Pastrakis">
          <span class="system-badge-dot" aria-hidden="true"></span>
          Open Source EmDash Template by Fotis Pastrakis
        </div>

        <!-- Main headline -->
        <h1 class="hero-headline">
          THE <span id="hero-edge-word" class="edge-pulsing-word accent" data-text="EDGE">EDGE</span> OF INNOVATION
        </h1>

        <!-- Subheading -->
        <p class="hero-subheading">
          Precision engineering for the high-stakes digital frontier. Uncompromising performance, surgical accuracy, seamless speed designed for those who command the cutting-edge.
        </p>

        <!-- CTAs (Don Norman Explicit Signifiers & Affordances) -->
        <div class="hero-actions">
          <button class="btn" data-open-modal id="hero-deploy-btn">DEPLOY INFRASTRUCTURE</button>
          <a href="/services" class="btn btn-outline" id="hero-specs-btn">VIEW SPECS</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       TELEMETRY STATS BAR (Don Norman Visibility of System Status)
  ════════════════════════════════════════════════════════ -->
  <StatsBar stats={telemetryStats} bgColor="#0B0C10" textColor="#F3F4F6" />

  <!-- ═══════════════════════════════════════════════════════
       TRUSTED BY SECTION
  ════════════════════════════════════════════════════════ -->
  <section id="trusted-by" class="trusted-by" aria-label="Trusted by">
    <div class="container">
      <p class="trusted-by-label">TRUSTED BY CORE OPERATIONS GLOBALLY</p>
      <div class="trusted-logos" role="list">
        <span class="trusted-logo-item" role="listitem">QUANTUM</span>
        <span class="trusted-logo-item" role="listitem">NEXUS</span>
        <span class="trusted-logo-item" role="listitem">AEGIS</span>
        <span class="trusted-logo-item" role="listitem">VANGUARD</span>
        <span class="trusted-logo-item" role="listitem">SYNDICATE</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       CORE SERVICES MATRIX SECTION (OOUX Service Objects)
  ════════════════════════════════════════════════════════ -->
  <section id="services" class="command-control" aria-label="Services">
    <div class="container">
      <div class="section-header section-header-split">
        <div>
          <h2>Core Engineering Services</h2>
          <p>Architected from the ground up for environments where micro-seconds matter.</p>
        </div>
        <a href="/services" class="link-arrow">Inspect All Services & Specs <span aria-hidden="true">→</span></a>
      </div>

      <ServiceShowcaseHome />
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       UPCOMING STRATEGY SESSIONS & SUMMITS (OOUX Event Objects)
  ════════════════════════════════════════════════════════ -->
  <section id="events" class="events-section" aria-label="Upcoming Events">
    <div class="container">
      <div class="section-header section-header-split">
        <div>
          <h2>Upcoming Strategy Sessions & Summits</h2>
          <p>Live strategy gatherings, keynotes, and engineering briefings.</p>
        </div>
        <a href="/events" class="link-arrow">View Full Event Archive <span aria-hidden="true">→</span></a>
      </div>

      <div class="events-grid">
        {featuredEvents.map(event => (
          <EventCard
            title={event.data.title}
            slug={event.id || event.slug}
            tagline={event.data.tagline}
            excerpt={event.data.excerpt}
            eventDate={event.data.eventDate}
            timeSlot={event.data.timeSlot}
            status={event.data.status}
            eventType={event.data.eventType}
            location={event.data.location}
            capacity={event.data.capacity}
            speakers={event.data.speakers}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       FORGED FOR THE EXTREMES
  ════════════════════════════════════════════════════════ -->
  <section id="about" class="forged-section" aria-label="About EDGE">
    <div class="container">
      <div class="forged-inner">

        <!-- Left: Content -->
        <div class="forged-content">
          <h2>Forged for the Extremes.</h2>
          <p>
            Our proprietary core operates in a vacuum of efficiency. By stripping away legacy layers and controlling hardware directly, we've achieved unprecedented throughput on every workload we touch.
          </p>

          <ul class="forged-list" role="list">
            <li class="forged-list-item">
              <span class="forged-list-icon" aria-hidden="true">
                <svg viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                  <polygon points="9,1 17,5 17,13 9,17 1,13 1,5" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  <polygon points="9,5 13,7 13,11 9,13 5,11 5,7" fill="#DC2626"/>
                </svg>
              </span>
              BARE-METAL ALLOCATION
            </li>
            <li class="forged-list-item">
              <span class="forged-list-icon" aria-hidden="true">
                <svg viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                  <polygon points="9,1 17,5 17,13 9,17 1,13 1,5" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  <polygon points="9,5 13,7 13,11 9,13 5,11 5,7" fill="#DC2626"/>
                </svg>
              </span>
              ASYNCHRONOUS I/O
            </li>
            <li class="forged-list-item">
              <span class="forged-list-icon" aria-hidden="true">
                <svg viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                  <polygon points="9,1 17,5 17,13 9,17 1,13 1,5" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  <polygon points="9,5 13,7 13,11 9,13 5,11 5,7" fill="#DC2626"/>
                </svg>
              </span>
              QUANTUM-RESISTANT ENCRYPTION
            </li>
          </ul>
        </div>

        <!-- Right: Illustration -->
        <div class="forged-illustration">
          <img
            src="/images/circuit-board.png"
            alt="EDGE proprietary circuit board with glowing red data pathways"
            width="600"
            height="450"
            loading="lazy"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       INTERACTIVE TEAM SHOWCASE (Focus-Card Grid)
  ════════════════════════════════════════════════════════ -->
  <section id="team-showcase" class="team-section" aria-label="Our team showcase">
    <div class="container">
      <div class="section-header section-header-split">
        <div>
          <h2>The Team Behind Edge</h2>
          <p>Every service that blooms, has the right people that make it happen.</p>
        </div>
        <a href="/team" class="link-arrow">VIEW ALL MEMBERS <span aria-hidden="true">→</span></a>
      </div>

      <TeamShowcaseHome />
    </div>
  </section>
  </main>

  <!-- TERMINAL ACCESS DRAWER MODAL -->
  <AccessModal />

</BaseLayout>

<script>
  // Don Norman Micro-Interactions: Mouse Spotlight & Physics Tracker across all OOUX cards
  const cards = document.querySelectorAll(
    '.feature-card, .service-card, .event-card, .portfolio-card, .team-card'
  ) as NodeListOf<HTMLElement>;

  cards.forEach((card) => {
    card.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      card.style.setProperty('--mouse-x', `${x}px`);
      card.style.setProperty('--mouse-y', `${y}px`);
    });
  });

  // Interactive Light Pulsing & Mesh Glow for "EDGE" in Hero Headline
  function initEdgeWordInteraction() {
    const $card = document.getElementById('hero-edge-word') as HTMLElement | null;
    if (!$card) return;

    const round = (value: number, precision = 3) => parseFloat(value.toFixed(precision));
    const clamp = (value: number, min = 0, max = 100) => Math.min(Math.max(value, min), max);

    const centerOfElement = ($el: HTMLElement): [number, number] => {
      const { left, top, width, height } = $el.getBoundingClientRect();
      return [width / 2, height / 2];
    };

    const pointerPositionRelativeToElement = ($el: HTMLElement, e: MouseEvent) => {
      const { left, top, width, height } = $el.getBoundingClientRect();
      const x = e.clientX - left;
      const y = e.clientY - top;
      const px = clamp((100 / Math.max(1, width)) * x);
      const py = clamp((100 / Math.max(1, height)) * y);
      return { pixels: [x, y], percent: [px, py] };
    };

    const distanceFromCenter = ($el: HTMLElement, x: number, y: number): [number, number] => {
      const [cx, cy] = centerOfElement($el);
      return [x - cx, y - cy];
    };

    const angleFromPointerEvent = ($el: HTMLElement, dx: number, dy: number): number => {
      let angleRadians = 0;
      let angleDegrees = 0;
      if (dx !== 0 || dy !== 0) {
        angleRadians = Math.atan2(dy, dx);
        angleDegrees = angleRadians * (180 / Math.PI) + 90;
        if (angleDegrees < 0) {
          angleDegrees += 360;
        }
      }
      return angleDegrees;
    };

    const closenessToEdge = ($el: HTMLElement, x: number, y: number): number => {
      const [cx, cy] = centerOfElement($el);
      const [dx, dy] = distanceFromCenter($el, x, y);
      let k_x = Infinity;
      let k_y = Infinity;
      if (dx !== 0) {
        k_x = cx / Math.abs(dx);
      }
      if (dy !== 0) {
        k_y = cy / Math.abs(dy);
      }
      return clamp(1 / Math.min(k_x, k_y), 0, 1);
    };

    const cardUpdate = (e: MouseEvent) => {
      const position = pointerPositionRelativeToElement($card, e);
      const [px, py] = position.pixels;
      const [perx, pery] = position.percent;
      const [dx, dy] = distanceFromCenter($card, px, py);
      const edge = closenessToEdge($card, px, py);
      const angle = angleFromPointerEvent($card, dx, dy);

      $card.style.setProperty('--pointer-x', `${round(perx)}%`);
      $card.style.setProperty('--pointer-y', `${round(pery)}%`);
      $card.style.setProperty('--pointer-°', `${round(angle)}deg`);
      $card.style.setProperty('--pointer-d', `${round(edge * 100)}`);

      $card.classList.remove('animating');
      $card.classList.remove('ambient-pulsing');
    };

    window.addEventListener('pointermove', (e: PointerEvent) => {
      const rect = $card.getBoundingClientRect();
      const isNear = (
        e.clientX >= rect.left - 250 &&
        e.clientX <= rect.right + 250 &&
        e.clientY >= rect.top - 250 &&
        e.clientY <= rect.bottom + 250
      );
      if (isNear) {
        cardUpdate(e);
      } else {
        $card.classList.add('ambient-pulsing');
      }
    }, { passive: true });

    function easeOutCubic(x: number): number {
      return 1 - Math.pow(1 - x, 3);
    }
    function easeInCubic(x: number): number {
      return x * x * x;
    }

    interface AnimateOptions {
      startValue?: number;
      endValue?: number;
      duration?: number;
      delay?: number;
      onUpdate?: (v: number) => void;
      ease?: (t: number) => number;
      onStart?: () => void;
      onEnd?: () => void;
    }

    function animateNumber(options: AnimateOptions) {
      const {
        startValue = 0,
        endValue = 100,
        duration = 1000,
        delay = 0,
        onUpdate = () => {},
        ease = (t: number) => t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2,
        onStart = () => {},
        onEnd = () => {},
      } = options;

      const startTime = performance.now() + delay;

      function update() {
        const currentTime = performance.now();
        const elapsed = currentTime - startTime;
        const t = Math.min(elapsed / Math.max(1, duration), 1);
        const easedValue = startValue + (endValue - startValue) * ease(t);

        onUpdate(easedValue);

        if (t < 1) {
          requestAnimationFrame(update);
        } else {
          onEnd();
        }
      }

      setTimeout(() => {
        onStart();
        requestAnimationFrame(update);
      }, delay);
    }

    // Intro Animation Sweep
    const playAnimation = () => {
      const angleStart = 110;
      const angleEnd = 465;

      $card.style.setProperty('--pointer-°', `${angleStart}deg`);
      $card.classList.add('animating');

      animateNumber({
        ease: easeOutCubic,
        duration: 500,
        onUpdate: (v) => {
          $card.style.setProperty('--pointer-d', v.toFixed(2));
        }
      });

      animateNumber({
        ease: easeInCubic,
        delay: 0,
        duration: 1500,
        endValue: 50,
        onUpdate: (v) => {
          const d = (angleEnd - angleStart) * (v / 100) + angleStart;
          $card.style.setProperty('--pointer-°', `${d.toFixed(2)}deg`);
        }
      });

      animateNumber({
        ease: easeOutCubic,
        delay: 1500,
        duration: 2250,
        startValue: 50,
        endValue: 100,
        onUpdate: (v) => {
          const d = (angleEnd - angleStart) * (v / 100) + angleStart;
          $card.style.setProperty('--pointer-°', `${d.toFixed(2)}deg`);
        }
      });

      animateNumber({
        ease: easeInCubic,
        duration: 1500,
        delay: 2500,
        startValue: 100,
        endValue: 0,
        onUpdate: (v) => {
          $card.style.setProperty('--pointer-d', v.toFixed(2));
        },
        onEnd: () => {
          $card.classList.remove('animating');
          $card.classList.add('ambient-pulsing');
        }
      });
    };

    setTimeout(() => {
      playAnimation();
    }, 400);
  }

  document.addEventListener('astro:page-load', initEdgeWordInteraction);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEdgeWordInteraction);
  } else {
    initEdgeWordInteraction();
  }
</script>
