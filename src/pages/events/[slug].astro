---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTitle from '../../components/PageTitle.astro';
import EntryListMeta from '../../components/EntryListMeta.astro';
import CTABand from '../../components/CTABand.astro';
import { getCollection, getEntry, render } from 'astro:content';

export const prerender = false;

const { slug } = Astro.params;

// Attempt to load from content collection first
let event: any = null;
let Content: any = null;

try {
  const entry = await getEntry('events', slug!);
  if (entry) {
    event = entry.data;
    const rendered = await render(entry);
    Content = rendered.Content;
  }
} catch (_) {
  // fallback if slug doesn't match collection
}

// 404 guard
if (!event) {
  return Astro.redirect('/events');
}

const statusConfig: Record<string, { label: string; color: string }> = {
  UPCOMING:  { label: 'UPCOMING',  color: '#22C55E' },
  LIVE:      { label: '● LIVE NOW', color: '#EF4444' },
  COMPLETED: { label: 'COMPLETED', color: '#9CA3AF' },
  RECURRING: { label: 'RECURRING', color: '#A78BFA' },
};
const sc = statusConfig[event.status] ?? statusConfig.UPCOMING;

const typeLabel: Record<string, string> = {
  VIRTUAL:   'Virtual Event',
  HYBRID:    'Hybrid Event',
  IN_PERSON: 'In-Person Event',
};

const fillPct = event.capacity?.totalSeats && event.capacity?.registeredCount
  ? Math.min(100, Math.round((event.capacity.registeredCount / event.capacity.totalSeats) * 100))
  : null;
const spotsLeft = event.capacity?.totalSeats && event.capacity?.registeredCount
  ? event.capacity.totalSeats - event.capacity.registeredCount
  : null;
---

<BaseLayout
  title={`${event.title} — Events — EDGE`}
  description={event.excerpt ?? `Join us for ${event.title}.`}
>
  {/* Scroll Progress Bar */}
  <div id="read-progress" style="position:fixed;top:0;left:0;height:3px;width:0%;background:linear-gradient(90deg,#DC2626,#701A1A);z-index:9999;transition:width 0.1s linear;" role="progressbar" aria-label="Reading progress"></div>

  <PageTitle
    title={event.title}
    subtitle={event.tagline}
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Events', href: '/events' },
      { label: event.title },
    ]}
  />

  <main class="main" id="site-content">
    <div class="container">
      <div class="content-sidebar">

        {/* ── Primary Article Column ── */}
        <article class="single-post" aria-labelledby="event-title">

          {/* Status + Type badge row */}
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:24px;flex-wrap:wrap;">
            <span style={`font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:0.12em;padding:4px 12px;border-radius:9999px;color:${sc.color};border:1px solid ${sc.color}50;background:${sc.color}18;`}>
              {sc.label}
            </span>
            <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;padding:4px 12px;border-radius:9999px;color:var(--color-silver);border:1px solid rgba(209,213,219,0.2);background:rgba(209,213,219,0.07);">
              {typeLabel[event.eventType] ?? event.eventType}
            </span>
          </div>

          {/* Meta Pillbar */}
          <EntryListMeta
            eventDate={event.eventDate}
            timeSlot={event.timeSlot}
            status={event.status}
            eventType={event.eventType}
            location={event.location}
            capacity={event.capacity}
          />

          {/* Key Takeaways Callout */}
          {event.keyTakeaways && event.keyTakeaways.length > 0 && (
            <div style="background:rgba(220,38,38,0.06);border:1px solid rgba(220,38,38,0.2);border-left:4px solid #DC2626;border-radius:var(--radius-md);padding:24px 28px;margin-bottom:36px;">
              <p style="font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:0.15em;color:var(--color-primary);margin-bottom:12px;">Key Takeaways</p>
              <ul style="display:flex;flex-direction:column;gap:8px;list-style:none;padding:0;margin:0;">
                {event.keyTakeaways.map((takeaway: string) => (
                  <li style="display:flex;align-items:flex-start;gap:10px;font-size:13px;color:var(--color-silver);line-height:1.5;">
                    <span style="color:#DC2626;font-weight:900;margin-top:1px;flex-shrink:0;">→</span>
                    {takeaway}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {/* MDX Body */}
          <div class="entry-content">
            {Content ? <Content /> : <p style="color:var(--color-muted);">Event details coming soon.</p>}
          </div>

          {/* Agenda Section */}
          {event.agenda && event.agenda.length > 0 && (
            <section style="margin-top:48px;" aria-labelledby="agenda-heading">
              <h2 id="agenda-heading" style="font-size:0.7rem;font-weight:900;text-transform:uppercase;letter-spacing:0.15em;color:var(--color-primary);margin-bottom:20px;display:flex;align-items:center;gap:10px;">
                <span style="display:inline-block;width:24px;height:1px;background:var(--color-primary);"></span>
                Event Agenda
              </h2>
              <div style="display:flex;flex-direction:column;gap:0;border:1px solid var(--color-border-deep);border-radius:var(--radius-md);overflow:hidden;">
                {event.agenda.map((item: any, i: number) => (
                  <div style={`display:grid;grid-template-columns:80px 1fr;gap:0;${i > 0 ? 'border-top:1px solid var(--color-border-deep);' : ''}`}>
                    <div style="padding:16px;background:rgba(220,38,38,0.05);border-right:1px solid var(--color-border-deep);display:flex;align-items:center;justify-content:center;">
                      <span style="font-family:'Courier New',monospace;font-size:12px;font-weight:700;color:var(--color-primary);">{item.time}</span>
                    </div>
                    <div style="padding:16px 20px;">
                      <p style="font-size:14px;font-weight:700;color:#FFFFFF;margin:0 0 4px 0;">{item.topic}</p>
                      {item.speakerName && (
                        <p style="font-size:11px;font-weight:600;color:var(--color-primary);margin:0 0 4px 0;text-transform:uppercase;letter-spacing:0.08em;">{item.speakerName}</p>
                      )}
                      {item.description && (
                        <p style="font-size:12px;color:var(--color-muted);margin:0;line-height:1.5;">{item.description}</p>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}

          {/* Featured Speakers Grid */}
          {event.speakers && event.speakers.length > 0 && (
            <section style="margin-top:48px;" aria-labelledby="speakers-heading">
              <h2 id="speakers-heading" style="font-size:0.7rem;font-weight:900;text-transform:uppercase;letter-spacing:0.15em;color:var(--color-primary);margin-bottom:20px;display:flex;align-items:center;gap:10px;">
                <span style="display:inline-block;width:24px;height:1px;background:var(--color-primary);"></span>
                Featured Speakers
              </h2>
              <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;">
                {event.speakers.map((speaker: any) => (
                  <div style="background:var(--color-surface-2);border:1px solid var(--color-border-deep);border-radius:var(--radius-md);padding:20px;text-align:center;transition:border-color 0.3s ease;" onmouseover="this.style.borderColor='#DC2626'" onmouseout="this.style.borderColor='var(--color-border-deep)'">
                    <div style="width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#380F15,#701A1A);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:20px;font-weight:800;color:#FFFFFF;border:2px solid rgba(220,38,38,0.3);">
                      {speaker.name.charAt(0)}
                    </div>
                    <p style="font-size:13px;font-weight:800;color:#FFFFFF;margin:0 0 2px;">{speaker.name}</p>
                    <p style="font-size:11px;color:var(--color-primary);margin:0 0 2px;font-weight:600;">{speaker.role}</p>
                    <p style="font-size:11px;color:var(--color-muted);margin:0;">{speaker.company}</p>
                  </div>
                ))}
              </div>
            </section>
          )}

        </article>

        {/* ── Sticky Sidebar ── */}
        <aside class="sidebar" style="align-self:start;position:sticky;top:100px;" aria-label="Event registration sidebar">

          {/* Registration Widget */}
          <div class="widget">
            <h3 class="widget-title">Reserve Your Spot</h3>

            {/* Capacity Bar */}
            {fillPct !== null && (
              <div style="margin-bottom:16px;">
                <div style="display:flex;justify-content:space-between;margin-bottom:6px;">
                  <span style="font-size:11px;color:var(--color-muted);font-weight:700;text-transform:uppercase;letter-spacing:0.08em;">Registration</span>
                  <span style={`font-size:11px;font-weight:800;color:${fillPct >= 90 ? '#EF4444' : '#22C55E'};`}>
                    {fillPct}% full
                  </span>
                </div>
                <div style="height:6px;background:rgba(255,255,255,0.07);border-radius:9999px;overflow:hidden;">
                  <div style={`height:100%;width:${fillPct}%;background:${fillPct >= 90 ? 'linear-gradient(90deg,#EF4444,#DC2626)' : 'linear-gradient(90deg,#22C55E,#16A34A)'};border-radius:9999px;transition:width 0.6s ease;`}></div>
                </div>
                <p style="font-size:11px;color:var(--color-muted);margin-top:6px;text-align:right;">
                  {spotsLeft} {spotsLeft === 1 ? 'spot' : 'spots'} remaining
                </p>
              </div>
            )}

            <a
              href={event.registrationUrl ?? '/contact'}
              class="btn"
              style="width:100%;justify-content:center;margin-bottom:10px;"
              id="event-register-btn"
            >
              Register Now
            </a>

            {/* Add to Calendar */}
            <div style="position:relative;" id="calendar-dropdown-wrapper">
              <button
                id="calendar-toggle-btn"
                style="width:100%;padding:10px 16px;background:var(--color-surface-2);border:1px solid var(--color-border-deep);border-radius:var(--radius-base);color:var(--color-silver);font-size:12px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:border-color 0.2s ease;"
                onmouseover="this.style.borderColor='#DC2626'" onmouseout="this.style.borderColor='var(--color-border-deep)'"
                aria-expanded="false"
                aria-controls="calendar-dropdown"
              >
                📅 Add to Calendar ▾
              </button>
              <ul
                id="calendar-dropdown"
                style="display:none;position:absolute;top:calc(100% + 4px);left:0;right:0;background:var(--color-surface-3);border:1px solid var(--color-border-deep);border-radius:var(--radius-base);overflow:hidden;z-index:50;list-style:none;padding:0;margin:0;"
              >
                <li><a href="#" style="display:block;padding:10px 14px;font-size:12px;color:var(--color-silver);text-decoration:none;transition:background 0.2s ease;" onmouseover="this.style.background='rgba(220,38,38,0.08)'" onmouseout="this.style.background='transparent'">Google Calendar</a></li>
                <li><a href="#" style="display:block;padding:10px 14px;font-size:12px;color:var(--color-silver);text-decoration:none;border-top:1px solid var(--color-border-deep);transition:background 0.2s ease;" onmouseover="this.style.background='rgba(220,38,38,0.08)'" onmouseout="this.style.background='transparent'">Apple Calendar (.ics)</a></li>
                <li><a href="#" style="display:block;padding:10px 14px;font-size:12px;color:var(--color-silver);text-decoration:none;border-top:1px solid var(--color-border-deep);transition:background 0.2s ease;" onmouseover="this.style.background='rgba(220,38,38,0.08)'" onmouseout="this.style.background='transparent'">Outlook Calendar</a></li>
              </ul>
            </div>
          </div>

          {/* Event Specs Widget */}
          <div class="widget">
            <h3 class="widget-title">Event Details</h3>
            <ul style="display:flex;flex-direction:column;gap:12px;list-style:none;padding:0;margin:0;">
              <li style="display:flex;align-items:flex-start;gap:10px;font-size:13px;color:var(--color-silver);">
                <span style="color:#DC2626;font-size:15px;flex-shrink:0;margin-top:1px;">📅</span>
                <span>{new Date(event.eventDate).toLocaleDateString('en-GB', { weekday:'long', year:'numeric', month:'long', day:'numeric' })}</span>
              </li>
              <li style="display:flex;align-items:flex-start;gap:10px;font-size:13px;color:var(--color-silver);">
                <span style="color:#DC2626;font-size:15px;flex-shrink:0;margin-top:1px;">🕐</span>
                <span>{event.timeSlot}</span>
              </li>
              <li style="display:flex;align-items:flex-start;gap:10px;font-size:13px;color:var(--color-silver);">
                <span style="color:#DC2626;font-size:15px;flex-shrink:0;margin-top:1px;">📍</span>
                <div>
                  <span style="display:block;">{event.location.name}</span>
                  {event.location.address && <span style="display:block;font-size:11px;color:var(--color-muted);margin-top:2px;">{event.location.address}</span>}
                </div>
              </li>
              {event.capacity?.totalSeats && (
                <li style="display:flex;align-items:flex-start;gap:10px;font-size:13px;color:var(--color-silver);">
                  <span style="color:#DC2626;font-size:15px;flex-shrink:0;margin-top:1px;">👥</span>
                  <span>{event.capacity.totalSeats} total seats</span>
                </li>
              )}
            </ul>
          </div>

          {/* Share Widget */}
          <div class="widget">
            <h3 class="widget-title">Share This Event</h3>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
              <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(event.title)}`} target="_blank" rel="noopener noreferrer" style="flex:1;min-width:80px;padding:8px;background:var(--color-surface-2);border:1px solid var(--color-border-deep);border-radius:var(--radius-base);font-size:11px;font-weight:700;color:var(--color-silver);text-decoration:none;text-align:center;transition:border-color 0.2s ease;" onmouseover="this.style.borderColor='#DC2626'" onmouseout="this.style.borderColor='var(--color-border-deep)'">
                𝕏 Twitter
              </a>
              <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent('https://edge-platform.com/events/' + slug)}`} target="_blank" rel="noopener noreferrer" style="flex:1;min-width:80px;padding:8px;background:var(--color-surface-2);border:1px solid var(--color-border-deep);border-radius:var(--radius-base);font-size:11px;font-weight:700;color:var(--color-silver);text-decoration:none;text-align:center;transition:border-color 0.2s ease;" onmouseover="this.style.borderColor='#DC2626'" onmouseout="this.style.borderColor='var(--color-border-deep)'">
                LinkedIn
              </a>
            </div>
          </div>

        </aside>
      </div>
    </div>
  </main>

  <CTABand
    title="Interested in attending?"
    subtitle="Get in touch to secure your spot before seats fill up."
    buttonLabel="Contact Us"
    buttonUrl="/contact"
    variant="scarlet"
  />
</BaseLayout>

<script>
  // Scroll progress bar
  const bar = document.getElementById('read-progress');
  if (bar) {
    window.addEventListener('scroll', () => {
      const el = document.documentElement;
      const scrolled = el.scrollTop / (el.scrollHeight - el.clientHeight);
      bar.style.width = `${Math.min(scrolled * 100, 100)}%`;
    }, { passive: true });
  }

  // Calendar dropdown toggle
  const calBtn = document.getElementById('calendar-toggle-btn');
  const calDrop = document.getElementById('calendar-dropdown');
  if (calBtn && calDrop) {
    calBtn.addEventListener('click', () => {
      const isOpen = calDrop.style.display === 'block';
      calDrop.style.display = isOpen ? 'none' : 'block';
      calBtn.setAttribute('aria-expanded', String(!isOpen));
    });
    document.addEventListener('click', (e) => {
      const wrapper = document.getElementById('calendar-dropdown-wrapper');
      if (wrapper && !wrapper.contains(e.target as Node)) {
        calDrop.style.display = 'none';
        calBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
