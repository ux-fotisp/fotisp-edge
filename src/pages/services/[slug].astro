---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTitle from '../../components/PageTitle.astro';
import CTABand from '../../components/CTABand.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map(entry => ({
    params: { slug: (entry as any).slug || entry.id.replace(/\.mdx?$/, '') },
    props: { entry },
  }));
}

const { slug } = Astro.params;
const allServicesCollection = await getCollection('services');
const entry = Astro.props.entry || allServicesCollection.find(s => 
  s.id === slug || s.id === `${slug}.mdx` || s.id === `${slug}.md` || (s as any).slug === slug
);

if (!entry) {
  return Astro.redirect('/services');
}

const { Content } = await render(entry);
const { title, tagline, excerpt, category = 'INFRASTRUCTURE', icon = '⚡', deliverables, slaMetrics, pricingTier = 'ENTERPRISE // CUSTOM SCOPE' } = entry.data;

const summaryText = tagline || excerpt || 'High-throughput, enterprise-grade engineering solutions designed for mission-critical infrastructure.';

const defaultDeliverables = [
  'Zero-Trust System Audits',
  'Automated Telemetry Pipeline',
  'Sub-Millisecond Edge Routing',
  '24/7 Monitoring & Incident Escalation'
];
const activeDeliverables = deliverables && deliverables.length > 0 ? deliverables : defaultDeliverables;

const defaultMetrics = [
  { label: 'EDGE LATENCY', value: '< 1ms' },
  { label: 'SLA UPTIME', value: '99.999%' },
  { label: 'SECURITY SCORE', value: '100/100' }
];
const activeMetrics = slaMetrics && slaMetrics.length > 0 ? slaMetrics : defaultMetrics;
---

<BaseLayout 
  title={`${title} — Services | EDGE`} 
  description={summaryText}
>
  {/* Fixed top reading progress bar */}
  <div id="read-progress" class="read-progress-bar" aria-hidden="true"></div>

  <PageTitle 
    title={title} 
    breadcrumbs={[
      { label: 'SERVICES', href: '/services' },
      { label: title.toUpperCase() }
    ]} 
  />

  <main class="main service-main" id="site-content">
    <div class="container">
      
      {/* 70/30 Split Layout */}
      <div class="service-detail-layout">
        
        {/* Main Column (70%) */}
        <article class="service-detail-content">
          
          {/* Executive Summary Box (bg-[#1A080B] with 4px #ee2626 left border) */}
          <div class="executive-summary-box">
            <span class="summary-badge">{category}</span>
            <p class="summary-text">{summaryText}</p>
          </div>

          {/* 2-Column Key Deliverables Card Grid */}
          <div class="deliverables-section">
            <h2 class="deliverables-grid-title">Key Capabilities & Deliverables</h2>
            <div class="deliverables-2col-grid">
              {activeDeliverables.map(del => (
                <div class="deliverable-grid-card">
                  <span class="del-check">✓</span>
                  <span class="del-text">{del}</span>
                </div>
              ))}
            </div>
          </div>

          {/* Rendered MDX Technical Specifications */}
          <div class="entry-content service-mdx-content">
            <h2 class="tech-specs-heading">Technical Specifications & Architecture</h2>
            <Content />
          </div>

        </article>

        {/* Sidebar (30%) — Sticky card top-24 */}
        <aside class="service-sidebar sticky top-24">
          <div class="service-proposal-card">
            
            {/* Category & Pricing Tier Badge */}
            <div class="proposal-badge-row">
              <span class="pricing-badge">{pricingTier}</span>
            </div>

            <h3 class="proposal-title">Scope Engagement</h3>
            <p class="proposal-desc">Deploy dedicated senior engineering leads to architect your custom solution.</p>

            {/* SLA Metrics Bar */}
            <div class="sla-metrics-container">
              <span class="sla-heading">VERIFIED SLA METRICS</span>
              <div class="sla-metrics-grid">
                {activeMetrics.map(metric => (
                  <div class="sla-metric-box">
                    <span class="sla-val">{metric.value}</span>
                    <span class="sla-lbl">{metric.label}</span>
                  </div>
                ))}
              </div>
            </div>

            {/* Primary CTA */}
            <a href="/contact" class="scope-project-btn">
              SCOPE PROJECT <span aria-hidden="true">→</span>
            </a>

            <div class="proposal-telemetry-foot">
              <span class="status-dot"></span>
              STATUS: SLA GUARANTEED
            </div>

          </div>
        </aside>

      </div>

    </div>
  </main>

  <CTABand 
    title="Ready to engineer your infrastructure breakthrough?" 
    description="Engage our senior team to conduct an architectural audit and deploy your micro-runtimes." 
    primaryCtaText="SCHEDULE TECHNICAL AUDIT" 
    primaryCtaHref="/contact" 
  />
</BaseLayout>

<style>
  /* Fixed top reading progress bar */
  .read-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: var(--color-scarlet-red, #ee2626);
    box-shadow: 0 0 10px var(--color-scarlet-red, #ee2626);
    width: 0%;
    z-index: 1000;
    transition: width 0.1s ease-out;
  }

  .service-main {
    background: var(--color-obsidian, #080303);
    padding-bottom: 80px;
  }

  /* 70/30 Split Layout */
  .service-detail-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 48px;
    align-items: start;
  }

  @media (max-width: 992px) {
    .service-detail-layout {
      grid-template-columns: 1fr;
    }
  }

  /* Sticky Sidebar */
  .sticky {
    position: sticky;
    top: 100px;
  }

  /* Executive Summary Box (bg-[#1A080B] with 4px #ee2626 left border) */
  .executive-summary-box {
    background: var(--color-burgundy, #1A080B);
    border-left: 4px solid var(--color-scarlet-red, #ee2626);
    border-top: 1px solid var(--color-border-deep, #380F15);
    border-right: 1px solid var(--color-border-deep, #380F15);
    border-bottom: 1px solid var(--color-border-deep, #380F15);
    border-radius: 0 var(--radius-md, 8px) var(--radius-md, 8px) 0;
    padding: 32px;
    margin-bottom: 40px;
  }

  .summary-badge {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--color-scarlet-red, #ee2626);
    background: rgba(238, 38, 38, 0.1);
    border: 1px solid rgba(238, 38, 38, 0.3);
    padding: 4px 10px;
    border-radius: 9999px;
    display: inline-block;
    margin-bottom: 12px;
  }

  .summary-text {
    font-size: 1.15rem;
    line-height: 1.7;
    color: #FFFFFF;
    font-weight: 600;
    margin: 0;
  }

  /* Key Deliverables 2-Column Grid */
  .deliverables-section {
    margin-bottom: 40px;
  }

  .deliverables-grid-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 20px;
    letter-spacing: var(--tracking-tight, -0.02em);
  }

  .deliverables-2col-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  @media (max-width: 640px) {
    .deliverables-2col-grid {
      grid-template-columns: 1fr;
    }
  }

  .deliverable-grid-card {
    background: var(--color-surface, #0F0909);
    border: 1px solid var(--color-border-deep, #380F15);
    border-radius: var(--radius-md, 8px);
    padding: 18px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: all 0.25s ease;
  }

  .deliverable-grid-card:hover {
    border-color: rgba(238, 38, 38, 0.5);
    box-shadow: 0 0 16px rgba(238, 38, 38, 0.2);
    transform: translateY(-2px);
  }

  .del-check {
    color: var(--color-scarlet-red, #ee2626);
    font-weight: 900;
    font-size: 1.1rem;
    filter: drop-shadow(0 0 6px rgba(238, 38, 38, 0.6));
  }

  .del-text {
    font-size: 13px;
    font-weight: 600;
    color: #D1D5DB;
  }

  /* Tech Specs Heading & Rendered MDX Content */
  .tech-specs-heading {
    font-size: 1.3rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-top: 40px;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border-deep, #380F15);
  }

  .service-mdx-content {
    font-size: 1rem;
    line-height: 1.8;
    color: #D1D5DB;
  }

  .service-mdx-content h2,
  .service-mdx-content h3 {
    color: #FFFFFF;
    margin-top: 28px;
    margin-bottom: 14px;
  }

  .service-mdx-content ul {
    margin-bottom: 24px;
    padding-left: 20px;
  }

  .service-mdx-content li {
    margin-bottom: 8px;
  }

  /* Sidebar Proposal Card */
  .service-proposal-card {
    background: var(--color-surface, #0F0909);
    border: 1px solid var(--color-border-deep, #380F15);
    border-radius: var(--radius-md, 8px);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .pricing-badge {
    font-family: monospace;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--color-scarlet-red, #ee2626);
    background: rgba(238, 38, 38, 0.12);
    border: 1px solid rgba(238, 38, 38, 0.3);
    padding: 4px 12px;
    border-radius: 9999px;
  }

  .proposal-title {
    font-size: 1.25rem;
    font-weight: 900;
    color: #FFFFFF;
    margin: 0;
  }

  .proposal-desc {
    font-size: 13px;
    color: #9CA3AF;
    line-height: 1.6;
    margin: 0;
  }

  /* SLA Metrics Grid */
  .sla-metrics-container {
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .sla-heading {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--color-scarlet-red, #ee2626);
    margin-bottom: 12px;
    display: block;
  }

  .sla-metrics-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sla-metric-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(26, 8, 11, 0.8);
    border: 1px solid var(--color-border-deep, #380F15);
    padding: 10px 14px;
    border-radius: 6px;
  }

  .sla-val {
    font-size: 1rem;
    font-weight: 900;
    color: #FFFFFF;
  }

  .sla-lbl {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #9CA3AF;
  }

  /* Scope Project Button (#ee2626 background) */
  .scope-project-btn {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #FFFFFF;
    background: var(--color-scarlet-red, #ee2626);
    padding: 14px;
    border-radius: 6px;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-shadow: 0 0 16px rgba(238, 38, 38, 0.4);
    transition: all 0.2s ease;
  }

  .scope-project-btn:hover {
    gap: 12px;
    box-shadow: 0 0 24px rgba(238, 38, 38, 0.6);
  }

  .proposal-telemetry-foot {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #9CA3AF;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 8px #10B981;
  }
</style>

<script>
  // Scroll progress bar calculation
  const bar = document.getElementById('read-progress');
  if (bar) {
    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      bar.style.width = Math.min(100, Math.max(0, scrolled)) + '%';
    }, { passive: true });
  }
</script>
