{
  "name": "fotisp-edge",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "clean:cache": "powershell -Command \"Remove-Item -Recurse -Force .astro, .wrangler, node_modules\\.vite -ErrorAction SilentlyContinue\"",
    "test": "npx tsx tests/qa-interactive-components.ts",
    "test:all": "npx tsx tests/qa-interactive-components.ts && npx tsx tests/qa-full-routing-suite.ts && npx tsx tests/qa-edge-suite.ts",
    "test:ssr": "npx tsx scripts/verify-ssr-routes.ts",
    "version:tag": "git tag -a v1.0.0-stable -m 'EDGE v1.0.0 Baseline'",
    "emergency:rollback": "git checkout main && git reset --hard v1.0.0-stable && git clean -fd",
    "astro": "astro"
  },
  "allowScripts": {
    "esbuild": true,
    "esbuild@0.28.1": true,
    "workerd": true,
    "workerd@1.20260730.1": true
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.7",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "6.0.2",
    "@cloudflare/workers-types": "5.20260801.1",
    "@keystatic/astro": "5.2.0",
    "@keystatic/core": "0.6.4",
    "astro": "^7.1.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "wrangler": "4.118.0"
  }
}
